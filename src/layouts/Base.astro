---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, abs } from "../lib/site";

interface Props {
  title: string;
  description: string;
  path: string;
  type?: "website" | "article";
  published?: string;
  updated?: string;
  section?: string;
  tags?: string[];
  image?: string;
  noindex?: boolean;
  schema?: object[];
}
const { title, description, path, type = "website", published, updated, section, tags = [], image = "/og.png", noindex = false, schema = [] } = Astro.props;
const canonical = abs(path);
const fullTitle = title.includes(SITE.name) || title.length > 48 ? title : `${title} | ${SITE.name}`;
const robots = noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const iso = (d?: string) => (d ? (d.length === 10 ? `${d}T09:00:00+00:00` : d) : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.author.name} />
    <meta name="theme-color" content="#0f6b5c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(image)} />
    {published && <meta property="article:published_time" content={iso(published)} />}
    {updated && <meta property="article:modified_time" content={iso(updated)} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
