---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Consent from "../components/Consent.astro";
import { SITE, abs } from "../lib/site";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object | object[];
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Canonical override (redirect pages point at their destination). */
  canonical?: string;
}
const { title, description, path, jsonld, noindex = false, ogType = "website" } = Astro.props;
const gsv = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bsv = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const canonical = abs(Astro.props.canonical ?? path);
const og = abs(SITE.ogImage);
const metaDesc = description.length > 158 ? description.slice(0, 155).replace(/[\s,;:]+\S*$/, "") + "…" : description;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDesc} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <meta name="theme-color" content="#0f766e" />
    {gsv && path === "/" && <meta name="google-site-verification" content={gsv} />}
    {bsv && path === "/" && <meta name="msvalidate.01" content={bsv} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="StateMaps — what iPhone apps say they collect, from App Store privacy labels" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={og} />
    <slot name="head" />
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x).replace(/</g, "\\u003c")} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Consent />
    <Analytics />
  </body>
</html>
