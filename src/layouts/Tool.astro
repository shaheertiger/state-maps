---
import Base from "./Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Faq from "../components/Faq.astro";
import AdSlot from "../components/AdSlot.astro";
import TrustBlock from "../components/TrustBlock.astro";
import { ORG, breadcrumbLd, faqLd } from "../lib/schema";
import { abs } from "../lib/site";
import { TOOLS } from "../lib/tools";
interface Props { slug: string; title: string; description: string; h1: string; lead: string; faq: [string, string][]; kicker?: string }
const { slug, title, description, h1, lead, faq, kicker = "Free tool" } = Astro.props;
const path = `/tools/${slug}/`;
const crumbs = [{ name: "Home", href: "/" }, { name: "Tools", href: "/tools/" }, { name: h1 }];
const ld = { "@context": "https://schema.org", "@graph": [ORG, { "@type": "WebApplication", name: h1, url: abs(path), applicationCategory: "UtilitiesApplication", operatingSystem: "Any", browserRequirements: "Requires JavaScript", offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, description }, breadcrumbLd(crumbs, path), faqLd(faq)] };
---
<Base title={title} description={description} path={path} jsonld={ld}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />
    <div class="grid lg:grid-cols-[minmax(0,1fr)_290px] gap-10 mt-5 items-start">
      <div class="min-w-0 max-w-[820px] tool-page">
        <div class="kicker kicker-pin">{kicker}</div>
        <h1 class="h1-page mt-3">{h1}</h1>
        <p class="lead mt-3">{lead}</p>
        <div class="border border-line rounded-[18px] mt-8 overflow-hidden">
          <div class="p-5 md:p-6 grid gap-4"><slot name="form" /></div>
          <div class="border-t border-line bg-panel p-5 md:p-6 min-h-[120px]" aria-live="polite" data-out><slot name="empty" /></div>
        </div>
        <div class="tool-prose"><slot /></div>
        <section class="mt-12"><h2 class="h2-page">FAQ</h2><Faq items={faq} /></section>
        <p class="mt-8 text-sm">More tools: {TOOLS.filter((t) => t.slug !== slug).map((t, i) => <>{i > 0 && " · "}<a class="link" href={`/tools/${t.slug}/`}>{t.name}</a></>)}</p>
        <TrustBlock path={path} />
      </div>
      <aside class="hidden lg:block sticky top-[92px]"><AdSlot w={290} h={250} id="tool-rail" /></aside>
    </div>
  </div>
</Base>
<style is:global>
  .tool-page label { font-size: 14px; font-weight: 650; display: block; margin-bottom: 6px; }
  .tool-page input:not([type="checkbox"]):not([type="radio"]):not([type="file"]), .tool-page select { font: inherit; font-size: 16px; height: 46px; width: 100%; border: 1px solid var(--color-line); border-radius: 12px; padding: 0 14px; background: #fff; color: var(--color-ink); }
  .tool-page input:focus, .tool-page select:focus { outline: none; border-color: var(--color-primary-soft); }
  .tool-prose h2 { font-size: 28px; letter-spacing: -0.025em; margin-top: 48px; }
  .tool-prose h3 { margin-top: 24px; }
  .tool-prose p, .tool-prose ul, .tool-prose ol { margin-top: 14px; }
  .tool-prose ul, .tool-prose ol { padding-left: 22px; display: grid; gap: 6px; list-style: disc; }
  .tool-prose ol { list-style: decimal; }
  .tool-prose a { color: var(--color-primary); font-weight: 550; }
  .big-out { font-size: 32px; font-weight: 750; letter-spacing: -0.03em; line-height: 1.1; }
  @media (max-width: 720px) { .tool-prose h2 { font-size: 22px; } .big-out { font-size: 25px; } }
</style>
