---
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { breadcrumbs } from "../lib/schema";
interface Props { title: string; description: string; path: string; h1?: string; updated?: string; noindex?: boolean }
const { title, description, path, h1, updated, noindex } = Astro.props;
const crumbs = [{ name: "Home", path: "/" }, { name: h1 ?? title, path }];
---
<Base title={title} description={description} path={path} noindex={noindex} schema={[breadcrumbs(crumbs)]}>
  <div class="mx-auto max-w-3xl px-4 pt-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-6 text-[2.2rem] font-extrabold tracking-tight text-ink">{h1 ?? title}</h1>
    {updated && <p class="mt-2 text-sm text-ink-3">Last updated {updated}</p>}
    <div class="prose-body mt-6"><slot /></div>
  </div>
</Base>
