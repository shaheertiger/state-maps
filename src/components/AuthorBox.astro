---
import { SITE } from "../lib/site";
---
<aside class="my-12 flex gap-4 rounded-2xl border border-line p-5 sm:p-6" aria-label="About the author">
  <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand text-lg font-bold text-white" aria-hidden="true">SM</span>
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-ink-3">Written by</p>
    <p class="mt-0.5 text-lg font-bold text-ink"><a href={SITE.author.url} rel="author" class="no-underline hover:underline">{SITE.author.name}</a></p>
    <p class="text-sm text-ink-3">{SITE.author.role}</p>
    <p class="mt-2 text-[0.95rem] leading-7 text-ink-2">{SITE.author.bio}</p>
    <p class="mt-2 text-sm"><a href="/how-we-review/" class="link">How we review apps</a> · <a href="/editorial-policy/" class="link">Editorial policy</a> · <a href="/contact/" class="link">Report a mistake</a></p>
  </div>
</aside>
