---
/** Dashed "route" accent with a pin: the site's signature divider. */
interface Props { center?: boolean }
const { center = false } = Astro.props;
---
<svg class:list={["block w-[84px] h-3 mt-[18px]", center && "mx-auto"]} viewBox="0 0 84 12" aria-hidden="true"><path d="M2 8 C 18 2, 30 2, 44 6 S 66 10, 74 6" fill="none" stroke="#e0a33b" stroke-width="2" stroke-dasharray="4 4" stroke-linecap="round"/><circle cx="78" cy="5" r="3.5" fill="#0f766e"/></svg>
