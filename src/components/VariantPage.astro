---
import Base from "../layouts/Base.astro";
import Breadcrumb from "./Breadcrumb.astro";
import LabelCard from "./LabelCard.astro";
import MiniLabel from "./MiniLabel.astro";
import AppGlyph from "./AppGlyph.astro";
import Faq from "./Faq.astro";
import AdSlot from "./AdSlot.astro";
import TrustBlock from "./TrustBlock.astro";
import SectionHead from "./fun/SectionHead.astro";
import QuickAnswer from "./fun/QuickAnswer.astro";
import Quiz from "./fun/Quiz.astro";
import Audit from "./fun/Audit.astro";
import { type App, url, getCategory, getTopic, similarApps, level, allTypes, tracks, hasTrackPage, hasLockPage, topicStats, list, lower, cap1, linkedTypes, highTypes, APPS, poss } from "../lib/data";
import { CARDS, dataType } from "../lib/labels";
import { trackTitle, trackDescription, trackAnswer, trackFaq, lockTitle, lockDescription, lockSteps, hideSteps, lockFaq, typeRows, settingsFor, quizFor, auditFor, TOPIC_NOTES, CATEGORY_NOTES } from "../lib/content";
import { appGraph } from "../lib/appSchema";
import { SITE } from "../lib/site";

interface Props { app: App; variant: "track" | "lock" }
const { app: a, variant } = Astro.props;
const path = url[variant](a);
const cat = getCategory(a.category);
const topic = getTopic(a.topic);
const d = a.display;
const D = poss(d);
const isTrack = variant === "track";
const h1 = isTrack ? `Does ${d} Track You?` : `How to Lock ${d} on iPhone`;
const title = isTrack ? trackTitle(a) : lockTitle(a);
const description = isTrack ? trackDescription(a) : lockDescription(a);
const quote = isTrack ? trackAnswer(a) : `Touch and hold ${D} icon, tap Require Face ID, then confirm. On iOS 18 and later that puts ${d} behind Face ID, Touch ID or your passcode; choose Hide and Require Face ID instead to move it into App Library's Hidden folder as well.`;
const faq = isTrack ? trackFaq(a) : lockFaq(a);
const crumbs = [{ name: "Home", href: "/" }, { name: cat.name, href: url.category(cat.slug) }, { name: d, href: url.app(a) }, { name: h1.replace(/\?$/, "") }];
const ld = appGraph({ app: a, path, headline: h1, description, crumbs, faq });
const s = topicStats(a.topic);
const peers = similarApps(a, 10).filter((x) => (isTrack ? hasTrackPage(x) : hasLockPage(x))).slice(0, 8);
const hub = isTrack ? { href: "/does-it-track-you/", label: "Who tracks you? A–Z" } : { href: "/lock-an-app/", label: "Lock an app: A–Z" };
const siblings = [
  { href: url.app(a), label: `Is ${d} safe? Full privacy report` },
  !isTrack && hasTrackPage(a) && { href: url.track(a), label: `Does ${d} track you?` },
  isTrack && hasLockPage(a) && { href: url.lock(a), label: `How to lock ${d} on iPhone` },
].filter(Boolean) as { href: string; label: string }[];
const rows = typeRows(a);
const held = highTypes(a);
const n = (k: number) => `${k} data type${k === 1 ? "" : "s"}`;
---
<Base title={title} description={description} path={path} jsonld={ld} ogType="article">
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />
    <div class="mt-3 md:mt-5 grid md:grid-cols-[minmax(0,1fr)_280px] items-center gap-x-10 gap-y-4">
      <div>
        <h1 class="h1-page">{h1}</h1>
        <p class="mt-1.5 md:mt-2 text-sm md:text-[17px] text-muted">{isTrack ? "From the App Store privacy label" : "iOS 18 Face ID lock and Hidden folder"} · {a.developer} · checked {SITE.verifiedLabel}</p>
      </div>
      <div class="map-tile hidden md:grid h-[140px] rounded-[18px] place-items-center"><AppGlyph app={a} size={64} /></div>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_290px] gap-10 mt-4 md:mt-8 items-start">
      <article class="min-w-0 max-w-[820px]">
        {isTrack ? (
          <section id="answer" class="panel border border-line p-5 md:p-6 grid sm:grid-cols-[auto_1fr] gap-4 sm:gap-8 items-center">
            <div>
              <div class="eyebrow text-muted flex items-center gap-2"><span class="dot" style="background:var(--color-track)"></span>Data used to track you</div>
              <div class="mt-2.5 text-[40px] md:text-[52px] font-[780] tracking-[-0.035em] leading-none" style={`color:${tracks(a) ? "#9b2c1c" : "#17633f"}`}>{tracks(a) ? "Yes" : "No"}</div>
            </div>
            <div><span class:list={["pill", tracks(a) ? "pill-no" : "pill-yes"]}>{tracks(a) ? `${a.track.length} data ${a.track.length === 1 ? "type" : "types"} for tracking` : level(a) === 1 ? "Collects no data" : "No tracking declared"}</span><p class="mt-2 text-[15px] text-muted">{tracks(a) ? cap1(list(lower(a.track))) + "." : `The label has no “${CARDS.track.title}” section.`}</p></div>
          </section>
        ) : (
          <section id="answer" class="panel border border-line p-5 md:p-6 grid sm:grid-cols-[auto_1fr] gap-4 sm:gap-8 items-center">
            <div>
              <div class="eyebrow text-muted flex items-center gap-2"><span class="dot bg-primary"></span>Time needed</div>
              <div class="mt-2.5 text-[40px] md:text-[52px] font-[780] tracking-[-0.035em] leading-none text-primary">4 taps</div>
            </div>
            <div><span class="pill pill-info">Needs iOS 18 or later</span><p class="mt-2 text-[15px] text-muted">Works for {d} whether or not it has its own passcode. No download needed.</p></div>
          </section>
        )}

        <QuickAnswer text={quote} />

        {isTrack && (
          <>
            <section class="mt-8 md:mt-12 longform">
              <h2 class="h2-page">What “tracking” means on an iPhone</h2>
              <p>{CARDS.track.means} It is narrower than “collecting data”: an app can collect a lot without tracking you, and a small app can track you with a single advertising SDK.</p>
              <p>Since iOS 14.5, App Tracking Transparency requires every app to ask before it accesses your device's advertising identifier or otherwise tracks you. The App Store label is where the developer declares which of its data is used that way. {tracks(a) ? `${d} declares ${n(a.track.length)}, so expect the “Allow ${d} to track your activity across other companies' apps and websites?” prompt.` : `${d} declares none, so it has no reason to show that prompt.`}</p>
            </section>

            {tracks(a) ? (
              <section class="mt-8 md:mt-12">
                <h2 class="h2-page">The data {d} uses to track you</h2>
                <ul class="grid gap-3 list-none p-0 mt-[18px]">
                  {a.track.map((t) => { const dt = dataType(t); return (
                    <li class="panel p-4 border border-line"><h3 class="!text-[17px]"><a href={url.dataType(dt.slug)} class="hover:text-primary">{t}</a></h3><p class="text-[15px] text-[#4d5b57] mt-1">{cap1(dt.plain)}. {dt.why}</p></li>
                  ); })}
                </ul>
              </section>
            ) : rows.length > 0 && (
              <section class="mt-8 md:mt-12">
                <h2 class="h2-page">What {d} collects instead</h2>
                <p class="mt-3">No tracking does not mean no collection. {D} label lists {n(rows.length)}{linkedTypes(a).length ? `, and ${list(lower(linkedTypes(a)))} ${linkedTypes(a).length === 1 ? "is" : "are"} linked to your identity` : ", none of it linked to you"}:</p>
                <ul class="prose-list">{rows.map((r) => <li><a href={url.dataType(r.slug)} class="link">{r.name}</a> — {r.plain} <span class="text-muted">({r.cards.map((k) => CARDS[k].short.toLowerCase()).join(", ")})</span></li>)}</ul>
              </section>
            )}

            <section class="mt-8 md:mt-12">
              <h2 class="h2-page">How to stop {d} from tracking you</h2>
              <ol class="prose-list">
                <li>When {d} shows the tracking prompt, tap <strong>Ask App Not to Track</strong>.</li>
                <li>Already said yes? Open <strong>Settings › Privacy & Security › Tracking</strong> and switch off the toggle next to {d}.</li>
                <li>To refuse every app in one go, switch off <strong>Allow Apps to Request to Track</strong> on the same screen. Apps then cannot ask, and are treated as if you declined.</li>
                <li>For Apple's own ads in the App Store, News and Stocks, see <strong>Settings › Privacy & Security › Apple Advertising</strong> and turn off Personalised Ads.</li>
                <li>Inside {d}, look for an analytics or personalised-ads switch in its own settings; it covers data the iOS switch does not.</li>
              </ol>
            </section>
          </>
        )}

        {!isTrack && (
          <>
            <section class="mt-8 md:mt-12">
              <h2 class="h2-page">Lock {d} with Face ID</h2>
              <ol class="prose-list">{lockSteps(a).map((x) => <li>{x}</li>)}</ol>
              <p class="mt-3 text-[15px] text-muted">To test it, close {d} from the App Switcher and open it again. You should see the Face ID prompt before any content appears.</p>
            </section>
            <section class="mt-8 md:mt-12">
              <h2 class="h2-page">Hide {d} in App Library</h2>
              <ol class="prose-list">{hideSteps(a).map((x) => <li>{x}</li>)}</ol>
              <p class="mt-3 text-[15px] text-muted">Hiding also locks the app. To undo either, touch and hold the icon again and choose Don't Require Face ID.</p>
            </section>
            <section class="mt-8 md:mt-12 longform">
              <h2 class="h2-page">Why lock {d}?</h2>
              <p>{held.length ? `${D} privacy label lists ${list(lower(held))} — the kind of data you would not want on screen if someone borrows your unlocked phone.` : `${d} is a ${topic.singular}, the kind of app that tends to hold personal information you would not want on screen if someone borrows your unlocked phone.`} {TOPIC_NOTES[a.topic].focus}</p>
              <p>{CATEGORY_NOTES[a.category]}</p>
              <p>A lock answers one question — who can open the app on this iPhone. It does not change what {d} sends to its developer; for that, see <a href={url.app(a)} class="link">{D} full privacy report</a>.</p>
            </section>
            <section class="mt-8 md:mt-12">
              <h2 class="h2-page">What the lock does and does not do</h2>
              <div class="grid sm:grid-cols-2 gap-3 mt-[18px]">
                <div class="panel p-5" style="background:var(--color-tint-green)"><h3 class="!text-[17px] text-[#17633f]">It does</h3><ul class="prose-list !text-[15px]"><li>Ask for Face ID, Touch ID or passcode every time {d} opens</li><li>Hide message previews in notifications</li><li>Keep {D} content out of Spotlight and Siri suggestions</li><li>With Hide, remove the icon from the Home Screen</li></ul></div>
                <div class="panel p-5" style="background:var(--color-tint-amber)"><h3 class="!text-[17px] text-[#865409]">It does not</h3><ul class="prose-list !text-[15px]"><li>Stop someone who knows your passcode</li><li>Encrypt or change how {d} stores data</li><li>Sync to your iPad or other devices</li><li>Remove {d} from purchase history or Screen Time reports</li></ul></div>
              </div>
            </section>
            <section class="mt-8 md:mt-12">
              <h2 class="h2-page">Don't see Require Face ID?</h2>
              <ul class="prose-list">
                <li>Update to iOS 18 or later in Settings › General › Software Update.</li>
                <li>Make sure a passcode is set in Settings › Face ID & Passcode; the lock needs one.</li>
                <li>Some Apple apps (Settings, Calculator, Camera, Maps, Find My, Clock) cannot be locked or hidden.</li>
                <li>If your iPhone is managed by work or school, the option may be restricted.</li>
              </ul>
            </section>
            <section class="mt-8 md:mt-12">
              <h2 class="h2-page">Other settings worth checking for {d}</h2>
              <ol class="grid sm:grid-cols-2 gap-3 list-none p-0 mt-[18px]">
                {settingsFor(a).filter(([t]) => t !== "Lock the app").map(([t, body]) => <li class="panel p-4 border border-line"><h3 class="!text-base !tracking-normal">{t}</h3><p class="step-d">{body}</p></li>)}
              </ol>
            </section>
          </>
        )}

        <section class="mt-8 md:mt-12">
          <h2 class="h2-page">{D} full privacy label</h2>
          <div class="mt-[18px]"><LabelCard app={a} id="full-label" /></div>
          <p class="mt-3 text-sm"><a href={url.app(a)} class="link">Is {d} safe? Every data type explained →</a></p>
        </section>

        {isTrack && s.n >= 5 && (
          <section class="mt-8 md:mt-12">
            <h2 class="h2-page">Do other {topic.name.toLowerCase()} track you?</h2>
            <p class="mt-3">{s.track}% of the {s.n} {topic.name.toLowerCase()} with a label in our snapshot declare tracking; {s.clean}% say they collect nothing at all. Nearby in the list:</p>
            <div class="table-wrap mt-4"><table class="data-table">
              <thead><tr><th>App</th><th>Tracks you?</th><th>Data types</th></tr></thead>
              <tbody>{peers.map((x) => <tr><td><a href={url.track(x)} class="font-[600] hover:text-primary">{x.display}</a></td><td><span class:list={["pill !text-[12.5px] !py-0.5", tracks(x) ? "pill-no" : "pill-yes"]}>{tracks(x) ? "Yes" : "No"}</span></td><td class="text-muted">{allTypes(x).length}</td></tr>)}</tbody>
            </table></div>
          </section>
        )}

        {!isTrack && (
          <section class="mt-8 md:mt-12">
            <h2 class="h2-page">Lock these apps too</h2>
            <ul class="list-none p-0 mt-4 grid sm:grid-cols-2 gap-x-6">{peers.map((x) => <li class="rowline"><a href={url.lock(x)} class="block py-2.5 text-[15px]">How to lock {x.display}</a></li>)}</ul>
          </section>
        )}

        <section class="mt-8 md:mt-12">
          <h2 class="h2-page">{isTrack ? "Check your settings" : `After you lock ${d}`}</h2>
          <Audit id={`au-${variant}-${a.id}`} title="Tick what you have done" items={auditFor(a)} />
        </section>

        {isTrack && (
          <section class="mt-8 md:mt-12">
            <h2 class="h2-page">True or false?</h2>
            <Quiz id={`qz-t-${a.id}`} items={quizFor(a).slice(0, 4)} />
          </section>
        )}

        <section id="faq" class="mt-8 md:mt-12">
          <h2 class="h2-page">FAQ</h2>
          <Faq items={faq} />
        </section>

        <p class="mt-8 text-sm flex flex-wrap gap-x-2 gap-y-1">{siblings.map((x, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<a href={x.href} class="link">{x.label} →</a></>)}<span aria-hidden="true">·</span><a href={hub.href} class="link">{hub.label} →</a><span aria-hidden="true">·</span><a href={url.category(cat.slug)} class="link">All {cat.name.toLowerCase()} apps →</a></p>
        <TrustBlock path={path} sourceName={isTrack ? `${d} on the App Store` : "Apple: lock or hide an app on iPhone"} sourceUrl={isTrack ? a.sourceUrl : "https://support.apple.com/guide/iphone/lock-or-hide-an-app-iph00f208d05/ios"} />
      </article>

      <aside class="hidden lg:grid sticky top-[92px] gap-5" aria-label="Summary">
        <MiniLabel app={a} />
        <AdSlot w={290} h={250} id={`${variant}-rail`} />
        <div class="border border-line rounded-[12px] p-4">
          <div class="eyebrow text-muted">More on {d}</div>
          <ul class="list-none mt-2.5 p-0 grid gap-2 text-sm">{siblings.map((x) => <li><a href={x.href}>{x.label}</a></li>)}<li><a href={hub.href}>{hub.label}</a></li></ul>
        </div>
        <p class="text-[12px] text-muted">{APPS.length.toLocaleString("en-US")} apps checked · {SITE.verifiedLabel}</p>
      </aside>
    </div>
  </div>
</Base>
