---
import AppIcon from "./AppIcon.astro";
import type { App, ListEntry } from "../data/types";
import { getApp, reviewUrl, altUrl, checklistScore, FEATURE_LABELS, comparisonBetween, compareUrl, hasAltPage } from "../data/index";
import { inline, slugify } from "../lib/md";
interface Props { entry: ListEntry; n: number; others: string[] }
const { entry, n, others } = Astro.props;
const a: App = getApp(entry.app);
const id = `${n}-${slugify(a.name)}`;
const score = checklistScore(a);
const vs = others.map((o) => comparisonBetween(a.slug, o)).find(Boolean);
const vsOther = vs ? getApp(vs.a === a.slug ? vs.b : vs.a) : undefined;
const freePlan = a.pricing.model === "Paid" ? "No" : a.pricing.model === "Built-in" ? "Built in, free" : "Yes";
---
<section class="relative mt-14 scroll-mt-20 border-t border-line pt-10 first:mt-6" aria-labelledby={id}>
  <span class="inline-flex items-center gap-1 rounded-full bg-ink px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
    {n === 1 && <span aria-hidden="true">★</span>} {entry.badge}
  </span>
  <div class="mt-4 flex items-center gap-4">
    <AppIcon name={a.name} slug={a.slug} size={56} />
    <div>
      <h2 id={id} class="!m-0 text-[1.75rem] font-extrabold leading-tight tracking-tight text-ink">{n}. {a.name}</h2>
      <p class="mt-1 text-sm text-ink-3">{a.developer && <span>By {a.developer} · </span>}{a.platforms.join(", ")}{a.openSource && " · Open source"}</p>
    </div>
  </div>

  <p class="mt-5" set:html={inline(entry.why)} />

  <div class="not-prose my-6 grid gap-4 rounded-2xl border border-line p-5 sm:grid-cols-[1fr_auto]">
    <dl class="grid grid-cols-[7.5rem_1fr] gap-x-3 gap-y-2 text-[0.95rem]">
      <dt class="font-semibold text-ink">Best for</dt><dd class="text-ink-2">{a.bestFor}</dd>
      <dt class="font-semibold text-ink">Platforms</dt><dd class="text-ink-2">{a.platforms.join(", ")}</dd>
      <dt class="font-semibold text-ink">Free plan</dt><dd class="text-ink-2">{freePlan}</dd>
      <dt class="font-semibold text-ink">Standout</dt><dd class="text-ink-2">{a.standout}</dd>
    </dl>
    <div class="flex flex-row items-center gap-3 border-t border-line pt-4 sm:flex-col sm:justify-center sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">
      <span class="text-3xl font-extrabold text-ink">{score}<span class="text-base font-semibold text-ink-3">/{FEATURE_LABELS.length}</span></span>
      <a href="/how-we-review/#checklist" class="text-xs font-semibold text-ink-3 no-underline hover:underline">Privacy checklist</a>
    </div>
  </div>

  <p><strong>What it is:</strong> <span set:html={inline(a.whatItIs)} /></p>

  <h3>How {a.name} works</h3>
  {a.howItWorks.map((p) => <p set:html={inline(p)} />)}

  <p><strong>Who it's for:</strong> <span set:html={inline(a.whoFor)} /></p>

  <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
    <p class="rounded-xl bg-[#ecf7ef] p-4 text-[0.97rem] leading-7 text-ink-2"><strong class="text-good">Pick {a.name} if:</strong> {a.pickIf}</p>
    <p class="rounded-xl bg-[#fdf0ef] p-4 text-[0.97rem] leading-7 text-ink-2"><strong class="text-bad">Skip {a.name} if:</strong> {a.skipIf}</p>
  </div>

  <h3>{a.name}: strengths vs. trade-offs</h3>
  <div class="not-prose overflow-hidden rounded-xl border border-line">
    <table class="tbl">
      <thead><tr><th class="w-1/2">What's good</th><th class="w-1/2">What's missing</th></tr></thead>
      <tbody>
        {Array.from({ length: Math.max(a.strengths.length, a.tradeoffs.length) }).map((_, i) => (
          <tr>
            <td class="text-ink-2">{a.strengths[i] && <span class="flex gap-2"><span class="text-good" aria-hidden="true">+</span><span>{a.strengths[i]}</span></span>}</td>
            <td class="text-ink-2">{a.tradeoffs[i] && <span class="flex gap-2"><span class="text-bad" aria-hidden="true">–</span><span>{a.tradeoffs[i]}</span></span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>{a.name} pricing</h3>
  <ul>
    <li><strong>Free:</strong> {a.pricing.free}</li>
    <li><strong>Paid:</strong> {a.pricing.paid}</li>
  </ul>

  <h3>Privacy: what to know</h3>
  <p set:html={inline(a.privacyNotes)} />

  <div class="not-prose mt-6 flex flex-wrap gap-3">
    <a href={reviewUrl(a.slug)} class="btn btn-primary">Full {a.name} review</a>
    {vs && vsOther && <a href={compareUrl(vs)} class="btn btn-ghost">{a.name} vs {vsOther.name}</a>}
    {hasAltPage(a) && <a href={altUrl(a.slug)} class="btn btn-ghost">{a.name} alternatives</a>}
    {a.website && <a href={a.website} class="btn btn-ghost" rel="nofollow noopener noreferrer" target="_blank">Official site ↗</a>}
  </div>
</section>
