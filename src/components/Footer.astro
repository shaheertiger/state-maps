---
import Logo from "./Logo.astro";
import { SITE } from "../lib/site";
import { categories, listUrl, guides, guideUrl, categoryUrl } from "../data/index";
---
<footer class="mt-20 border-t border-line bg-wash">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo />
      <p class="mt-3 text-sm leading-6 text-ink-3">{SITE.tagline}. No sponsored rankings: apps can't pay for a spot on our lists.</p>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">Best apps</p>
      <ul class="mt-3 space-y-2 text-sm">
        {categories.map((c) => <li><a class="text-ink-3 no-underline hover:text-ink" href={listUrl(c.pillar)}>Best {c.short.toLowerCase()} apps</a></li>)}
        <li><a class="text-ink-3 no-underline hover:text-ink" href="/best-calculator-vault-apps/">Best calculator vault apps</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">Popular guides</p>
      <ul class="mt-3 space-y-2 text-sm">
        {guides.slice(0, 6).map((g) => <li><a class="text-ink-3 no-underline hover:text-ink" href={guideUrl(g.slug)}>{g.title.split(" (")[0]}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink">StateMaps</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-ink-3 no-underline hover:text-ink" href="/about/">About us</a></li>
        <li><a class="text-ink-3 no-underline hover:text-ink" href="/how-we-review/">How we review apps</a></li>
        <li><a class="text-ink-3 no-underline hover:text-ink" href="/editorial-policy/">Editorial policy</a></li>
        <li><a class="text-ink-3 no-underline hover:text-ink" href="/affiliate-disclosure/">Affiliate disclosure</a></li>
        <li><a class="text-ink-3 no-underline hover:text-ink" href="/contact/">Contact</a></li>
        <li><a class="text-ink-3 no-underline hover:text-ink" href="/privacy/">Privacy policy</a></li>
        <li><a class="text-ink-3 no-underline hover:text-ink" href="/terms/">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-xs text-ink-3">
      <p>© {SITE.year} {SITE.name}. App names and logos belong to their owners.</p>
      <p class="flex gap-4">{categories.map((c) => <a class="no-underline hover:text-ink" href={categoryUrl(c.slug)}>{c.short}</a>)}</p>
    </div>
  </div>
</footer>
