---
import Logo from "./Logo.astro";
import RouteLine from "./RouteLine.astro";
import { SITE } from "../lib/site";
import { APPS } from "../lib/data";
const cols = [
  { h: "Browse", links: [["All apps by category", "/app-privacy/"], ["Who tracks you? A–Z", "/does-it-track-you/"], ["Is it safe? A–Z", "/is-it-safe/"], ["Lock apps on iPhone", "/lock-an-app/"], ["Data types explained", "/data-types/"]] },
  { h: "Tools", links: [["App privacy checker", "/tools/app-privacy-checker/"], ["Compare two apps", "/tools/compare-apps/"], ["Privacy label decoder", "/tools/privacy-label-decoder/"], ["iPhone privacy checkup", "/tools/privacy-checkup/"], ["Photo metadata viewer", "/tools/exif-viewer/"]] },
  { h: "Guides", links: [["All guides", "/blog/"], ["iPhone privacy settings", "/privacy-settings/"], ["Hide apps", "/hide-apps/"], ["Glossary", "/glossary/"], ["Compare storage options", "/compare/photo-storage-options/"]] },
  { h: "About", links: [["How we collect data", "/data-methodology/"], ["About", "/about/"], ["Contact & corrections", "/contact/"], ["Privacy", "/privacy/"], ["Terms", "/terms/"]] },
];
---
<footer class="bg-[#0f1c19] text-[#c9d6d2] mt-24 pt-14 pb-8">
  <div class="container-site">
    <div class="grid gap-9 md:grid-cols-[1.3fr_repeat(4,minmax(0,1fr))]">
      <div>
        <a href="/" class="flex items-center gap-2.5 font-[760] text-[22px] text-white hover:text-white"><Logo /><span>StateMaps</span></a>
        <RouteLine />
        <p class="mt-4 text-sm max-w-xs">What {APPS.length.toLocaleString("en-US")} iPhone apps say they collect, straight from App Store privacy labels. Independent and not affiliated with Apple.</p>
      </div>
      {cols.map((c) => (
        <div>
          <h2 class="ft-h">{c.h}</h2>
          <ul class="ft-l list-none m-0 p-0 grid gap-2 text-sm">
            {c.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="flex flex-wrap justify-between gap-3 border-t border-white/10 mt-10 pt-[18px] text-[13px] text-[#93a5a0]">
      <span>© {new Date(SITE.verifiedISO).getFullYear()} {SITE.domain}. Labels are developer-reported; we do not test apps.</span>
      <span class="flex flex-wrap gap-[18px]"><a href="/terms/" class="hover:text-white">Terms</a><a href="/privacy/" class="hover:text-white">Privacy</a><a href="/sitemap.xml" class="hover:text-white">Sitemap</a></span>
    </div>
  </div>
</footer>
