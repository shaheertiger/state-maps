---
interface Props { items: { id: string; label: string; sub?: boolean }[] }
const { items } = Astro.props;
---
<nav aria-label="Table of contents" class="text-sm">
  <p class="mb-3 text-xs font-bold uppercase tracking-wide text-ink-3">On this page</p>
  <ol class="space-y-1 border-l border-line">
    {items.map((it) => (
      <li>
        <a href={`#${it.id}`} class={`-ml-px block border-l border-transparent py-1 pr-2 text-ink-2 no-underline hover:border-brand hover:text-ink ${it.sub ? "pl-6 text-[0.84rem]" : "pl-3"}`}>{it.label}</a>
      </li>
    ))}
  </ol>
</nav>
