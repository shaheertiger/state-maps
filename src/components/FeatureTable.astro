---
import type { App, Flag } from "../data/types";
import { FEATURE_LABELS, flagText } from "../data/index";
interface Props { apps: App[] }
const { apps } = Astro.props;
const tone: Record<Flag, string> = { yes: "text-good", no: "text-bad", partial: "text-warn", unknown: "text-ink-3" };
const icon: Record<Flag, string> = { yes: "✓", no: "✕", partial: "◐", unknown: "?" };
---
<div class="not-prose overflow-x-auto rounded-xl border border-line">
  <table class="tbl min-w-[28rem]">
    <thead>
      <tr><th>Privacy checklist</th>{apps.map((a) => <th class="text-center">{a.name}</th>)}</tr>
    </thead>
    <tbody>
      {FEATURE_LABELS.map((f) => (
        <tr>
          <td><span class="font-medium text-ink">{f.label}</span><span class="block text-xs text-ink-3">{f.hint}</span></td>
          {apps.map((a) => (
            <td class={`text-center font-semibold ${tone[a.features[f.key]]}`}>
              <span aria-hidden="true">{icon[a.features[f.key]]}</span> <span class="text-sm">{flagText[a.features[f.key]]}</span>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
