---
import Breadcrumbs from "./Breadcrumbs.astro";
import { SITE } from "../lib/site";
import { fmtDate } from "../lib/md";
interface Props {
  crumbs: { name: string; path: string }[];
  kicker?: string;
  title: string;
  dek?: string;
  published: string;
  updated: string;
  minutes: number;
}
const { crumbs, kicker, title, dek, published, updated, minutes } = Astro.props;
---
<header class="border-b border-line bg-wash">
  <div class="mx-auto max-w-6xl px-4 pb-8 pt-6">
    <Breadcrumbs items={crumbs} />
    {kicker && <p class="mt-6 text-sm font-semibold uppercase tracking-wide text-brand">{kicker}</p>}
    <h1 class="mt-2 max-w-4xl text-[2rem] font-extrabold leading-[1.15] tracking-tight text-ink sm:text-[2.6rem]">{title}</h1>
    {dek && <p class="mt-4 max-w-3xl text-lg leading-8 text-ink-2">{dek}</p>}
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-3">
      <span class="flex items-center gap-2">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand text-xs font-bold text-white" aria-hidden="true">SM</span>
        <span>By <a href={SITE.author.url} rel="author" class="font-semibold text-ink no-underline hover:underline">{SITE.author.name}</a></span>
      </span>
      <span>Updated <time datetime={updated}>{fmtDate(updated)}</time></span>
      {published !== updated && <span class="hidden sm:inline">First published <time datetime={published}>{fmtDate(published)}</time></span>}
      <span>{minutes} min read</span>
      <a href="/how-we-review/" class="flex items-center gap-1 text-good no-underline hover:underline">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" /></svg>
        Fact-checked against official docs
      </a>
    </div>
  </div>
</header>
