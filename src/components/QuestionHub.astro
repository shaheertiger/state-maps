---
/**
 * A–Z question hubs. The index lists every letter with a preview; each letter has its own page
 * with the full list (keeps each page a reasonable size with ~4,500 apps).
 */
import Base from "../layouts/Base.astro";
import Breadcrumb from "./Breadcrumb.astro";
import TrustBlock from "./TrustBlock.astro";
import { APPS, type App, url, level, LEVELS, tracks, hasTrackPage, hasLockPage, allTypes, LETTERS, letterOf as keyOf } from "../lib/data";
import { breadcrumbLd, ORG } from "../lib/schema";
import { abs } from "../lib/site";

export type HubKind = "track" | "safe" | "lock";
interface Props { kind: HubKind; letter?: string }
const { kind, letter } = Astro.props;
const N = (n: number) => n.toLocaleString("en-US");
const cfg = {
  track: { base: "/does-it-track-you/", h1: "Does it track you?", title: "Which iPhone Apps Track You? {n} Apps Checked, A–Z", desc: "Yes-or-no tracking answers for {n} iPhone apps, straight from their App Store privacy labels, with the data each one uses to track you.", filter: hasTrackPage, href: url.track, q: (a: App) => `Does ${a.display} track you?`, a: (a: App) => (tracks(a) ? { tone: "no", text: `Yes · ${a.track.length}` } : { tone: "yes", text: "No" }) },
  safe: { base: "/is-it-safe/", h1: "Is it safe?", title: "Is It Safe? Privacy Labels for {n} iPhone Apps, A–Z", desc: "What {n} iPhone apps disclose on their App Store privacy labels: tracking, data linked to you, or nothing collected. Every app, A–Z.", filter: (_: App) => true, href: url.app, q: (a: App) => `Is ${a.display} safe?`, a: (a: App) => ({ tone: ["caution", "yes", "info", "caution", "no"][level(a)], text: LEVELS[level(a)].short }) },
  lock: { base: "/lock-an-app/", h1: "Lock an app on iPhone", title: "How to Lock Apps on iPhone: Face ID Guides for {n} Apps, A–Z", desc: "Step-by-step iOS 18 guides to lock or hide {n} finance, health, photo, messaging and password apps behind Face ID, Touch ID or your passcode.", filter: hasLockPage, href: url.lock, q: (a: App) => `How to lock ${a.display}`, a: (a: App) => ({ tone: "neutral", text: allTypes(a).length ? `${allTypes(a).length} data types` : "" }) },
}[kind];
const all = APPS.filter(cfg.filter).sort((a, b) => a.display.localeCompare(b.display, "en", { sensitivity: "base" }));

const groups = new Map<string, App[]>();
for (const a of all) groups.set(keyOf(a), [...(groups.get(keyOf(a)) ?? []), a]);

const n = all.length;
const path = letter ? `${cfg.base}${letter}/` : cfg.base;
const list = letter ? groups.get(letter) ?? [] : [];
const h1 = letter ? `${cfg.h1} Apps starting with ${letter.toUpperCase()}` : cfg.h1;
const title = letter ? `${cfg.h1.replace(/\?$/, "")}: Apps Starting With ${letter.toUpperCase()} (${list.length}) | StateMaps` : cfg.title.replace("{n}", N(n));
const desc = letter ? `${cfg.h1} ${list.length} iPhone apps starting with ${letter.toUpperCase()}, from ${list[0]?.display ?? ""} to ${list[list.length - 1]?.display ?? ""}. Answers from App Store privacy labels.`.slice(0, 158) : cfg.desc.replace("{n}", N(n));
const crumbs = [{ name: "Home", href: "/" }, ...(letter ? [{ name: cfg.h1, href: cfg.base }, { name: letter.toUpperCase() }] : [{ name: cfg.h1 }])];
const items = letter ? list : all.slice(0, 0);
const ld = { "@context": "https://schema.org", "@graph": [ORG, { "@type": "ItemList", name: h1, numberOfItems: letter ? list.length : n, itemListElement: (letter ? list : LETTERS.filter((L) => groups.has(L)).map((L) => groups.get(L)![0])).slice(0, 200).map((a, i) => ({ "@type": "ListItem", position: i + 1, name: cfg.q(a), url: abs(cfg.href(a)) })) }, breadcrumbLd(crumbs, path)] };
const others = [["/does-it-track-you/", "Does it track you?"], ["/is-it-safe/", "Is it safe?"], ["/lock-an-app/", "Lock an app"]].filter(([h]) => h !== cfg.base);
const tone = (t: string) => (t === "yes" ? "text-yes" : t === "no" ? "text-no" : t === "info" ? "text-notlinked" : t === "caution" ? "text-caution" : "text-muted");
const trackCount = kind === "track" ? all.filter(tracks).length : 0;
---
<Base title={title} description={desc} path={path} jsonld={ld}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />
    <div class="kicker kicker-pin mt-5">Question hub · {N(letter ? list.length : n)} answers</div>
    <h1 class="h1-page mt-3">{h1}</h1>
    <p class="lead mt-3 max-w-[700px]">{desc}</p>
    {kind === "track" && !letter && <p class="mt-4 max-w-[700px]"><strong>{N(trackCount)} of {N(n)}</strong> apps with a privacy label ({Math.round((trackCount / n) * 100)}%) declare data used to track you. Tracking means combining your data with other companies' data for advertising, or sharing it with data brokers. You can refuse it on any iPhone in Settings › Privacy & Security › Tracking.</p>}
    {kind === "lock" && !letter && <p class="mt-4 max-w-[700px]">Every guide uses the same built-in iOS 18 feature: touch and hold the app, tap <strong>Require Face ID</strong>, confirm. Each page adds why that particular app is worth locking and the other settings to check.</p>}
    <nav aria-label="Jump to letter" class="sticky top-[66px] z-10 bg-white py-3 mt-6 rowline flex flex-wrap gap-1">
      {LETTERS.map((L) => groups.has(L) ? <a href={`${cfg.base}${L}/`} class:list={["min-w-8 h-8 px-1.5 grid place-items-center rounded-lg text-sm font-[650] hover:bg-tab", L === letter && "bg-primary text-white hover:bg-primary hover:text-white"]} aria-current={L === letter ? "page" : undefined}>{L.toUpperCase()}</a> : <span class="min-w-8 h-8 grid place-items-center text-sm text-faint" aria-hidden="true">{L.toUpperCase()}</span>)}
    </nav>
    {letter ? (
      <ul class="list-none p-0 mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6">
        {items.map((a) => { const r = cfg.a(a); return <li class="rowline"><a href={cfg.href(a)} class="flex justify-between gap-3 py-3 text-[15px]"><span>{cfg.q(a)}</span><span class:list={["shrink-0 text-[13px] font-[600]", tone(r.tone)]}>{r.text}</span></a></li>; })}
      </ul>
    ) : (
      LETTERS.filter((L) => groups.has(L)).map((L) => (
        <section class="mt-8">
          <div class="flex items-baseline justify-between gap-4"><h2 class="!text-[28px]"><a href={`${cfg.base}${L}/`} class="hover:text-primary">{L.toUpperCase()}</a></h2><a href={`${cfg.base}${L}/`} class="link text-sm">All {groups.get(L)!.length} →</a></div>
          <ul class="list-none p-0 mt-2 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6">
            {groups.get(L)!.slice(0, 9).map((a) => { const r = cfg.a(a); return <li class="rowline"><a href={cfg.href(a)} class="flex justify-between gap-3 py-2.5 text-[15px]"><span class="truncate">{cfg.q(a)}</span><span class:list={["shrink-0 text-[13px] font-[600]", tone(r.tone)]}>{r.text}</span></a></li>; })}
          </ul>
        </section>
      ))
    )}
    <p class="mt-10 text-sm">Other question hubs: {others.map(([h, l], i) => <>{i > 0 && " · "}<a href={h} class="link">{l}</a></>)} · <a href="/app-privacy/" class="link">All apps by category</a> · <a href="/data-types/" class="link">Data types</a></p>
    <TrustBlock path={path} />
  </div>
</Base>
