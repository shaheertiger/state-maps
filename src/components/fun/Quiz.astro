---
/** True-or-false quiz; answers reveal on tap (CSS only). */
import type { Quiz } from "../../lib/content";
interface Props { id: string; items: Quiz[] }
const { id, items } = Astro.props;
---
<ol class="grid gap-3 list-none p-0 mt-[18px]">
  {items.map((q, i) => (
    <li class="qz box">
      <fieldset class="m-0 p-0 border-0">
        <legend class="qz-q"><span class="text-primary mr-1.5">Q{i + 1}</span>{q.q}</legend>
        <div class="flex gap-2 mt-3">
          <input class="sr-only" type="radio" name={`${id}-${i}`} id={`${id}-${i}-t`} data-ok={q.answer ? "1" : "0"} />
          <label for={`${id}-${i}-t`} class="ck-chip">True</label>
          <input class="sr-only" type="radio" name={`${id}-${i}`} id={`${id}-${i}-f`} data-ok={q.answer ? "0" : "1"} />
          <label for={`${id}-${i}-f`} class="ck-chip">False</label>
        </div>
      </fieldset>
      <div class="qz-out" aria-live="polite">
        <div class="qz-right font-[700] text-[#17633f]">Right.</div>
        <div class="qz-wrong font-[700] text-[#9b2c1c]">Not quite.</div>
        <p class="ck-t">{q.why}</p>
      </div>
    </li>
  ))}
</ol>
