---
import Icon from "./Icon.astro";
interface Props { title: string; text: string; links: { href: string; label: string; icon: string }[] }
const { title, text, links } = Astro.props;
---
<div class="panel p-5 md:p-7 mt-10 text-white relative overflow-hidden" style="background:linear-gradient(120deg,#0b4f49,#0f766e 60%,#13897f)">
  <svg aria-hidden="true" class="hidden sm:block absolute -right-6 -bottom-8 w-[200px] opacity-20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14" /></svg>
  <div class="text-[22px] md:text-[26px] font-[720] tracking-[-0.02em]">{title}</div>
  <p class="text-[15px] text-[#cdeee8] mt-1.5 max-w-[540px]">{text}</p>
  <div class="flex flex-wrap gap-2.5 mt-4">
    {links.map((l) => <a href={l.href} class="lift inline-flex items-center gap-2 rounded-full bg-white text-[#0b5f58] px-4 py-2.5 text-sm font-[700] hover:text-[#0b5f58]"><Icon name={l.icon} size={16} />{l.label}</a>)}
  </div>
</div>
