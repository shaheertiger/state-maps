---
/** Number of data types on each label, as horizontal bars, coloured by exposure level. */
interface Props { rows: { name: string; href?: string; count: number; level: number; me?: boolean }[]; title: string; note: string }
const { rows, title, note } = Astro.props;
const max = Math.max(...rows.map((r) => r.count), 1);
const COL = ["#9aa8a4", "#1f8a5b", "#2d64ad", "#b26b12", "#c2412d"];
---
<div class="box mt-[18px]">
  <div class="text-[15px] font-[700]">{title}</div>
  <ul class="grid gap-2.5 list-none p-0 mt-3">
    {rows.map((r) => (
      <li class="cc-row">
        {r.href ? <a href={r.href} class="text-[13px] md:text-sm truncate hover:text-primary">{r.name}</a> : <span class="text-[13px] md:text-sm font-[750] truncate">{r.name} (this app)</span>}
        <div class="h-6 rounded-md bg-[#eef3f1]">
          <div class="cc-bar" style={`width:${Math.max((r.count / max) * 100, 7)}%;min-width:max-content;padding-left:8px;background:${COL[r.level]};${r.me ? "box-shadow:0 0 0 2px #13201d inset" : ""}`}>
            <span class="cc-n">{r.count}</span>
          </div>
        </div>
      </li>
    ))}
  </ul>
  <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3 text-[12px] text-[#4d5b57]">
    <span><span class="dot mr-1" style="background:#c2412d"></span>Tracks you</span><span><span class="dot mr-1" style="background:#b26b12"></span>Linked to you</span><span><span class="dot mr-1" style="background:#2d64ad"></span>Not linked</span><span><span class="dot mr-1" style="background:#1f8a5b"></span>Collects nothing</span>
  </div>
  <p class="text-[12px] text-[#4d5b57] mt-2">{note}</p>
</div>
