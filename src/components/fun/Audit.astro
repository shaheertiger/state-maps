---
/** Tick-box audit for your own phone; a done state appears once every box is ticked (CSS only). */
import Icon from "./Icon.astro";
interface Props { id: string; title: string; items: { title: string; text: string }[] }
const { id, title, items } = Astro.props;
---
<div class="au box mt-[18px]">
  <div class="text-[15px] font-[700]">{title}</div>
  <ul class="grid sm:grid-cols-2 gap-2 list-none p-0 mt-3">
    {items.map((it, i) => (
      <li><input class="sr-only au-box" type="checkbox" id={`${id}-${i}`} /><label for={`${id}-${i}`} class="au-item"><span class="au-tick" aria-hidden="true">✓</span><span><span class="au-t">{it.title}</span><span class="au-d">{it.text}</span></span></label></li>
    ))}
  </ul>
  <div class="mt-3" aria-live="polite">
    <div class="au-todo flex gap-2 items-center text-[13px] text-muted"><Icon name="list" size={15} />Tick each step as you do it on your iPhone.</div>
    <div class="au-done gap-2.5 items-center panel !rounded-[12px] p-3" style="background:var(--color-tint-green)"><span class="text-[#17633f]"><Icon name="shieldok" size={20} /></span><p class="text-[14px] text-[#17633f] font-[650]">Done. You have applied every control the label points to.</p></div>
  </div>
</div>
