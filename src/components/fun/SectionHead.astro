---
import Icon from "./Icon.astro";
interface Props { icon: string; tint?: string; ink?: string; kicker?: string }
const { icon, tint = "var(--color-tint-teal)", ink = "var(--color-teal-ink)", kicker } = Astro.props;
---
<div class="flex items-start gap-3.5">
  <span class="icon-chip mt-0.5" style={`background:${tint};color:${ink}`}><Icon name={icon} size={19} /></span>
  <div class="min-w-0">
    {kicker && <div class="eyebrow" style={`color:${ink}`}>{kicker}</div>}
    <h2 class="h2-page"><slot /></h2>
  </div>
</div>
