---
import type { ArticleRef } from "../data/index";
import { categoryBySlug } from "../data/index";
interface Props { items: ArticleRef[]; title?: string; id?: string }
const { items, title = "Related articles", id = "related" } = Astro.props;
---
{items.length > 0 && (
  <section aria-labelledby={id} class="my-12">
    <h2 id={id} class="mb-5 text-[1.45rem] font-extrabold tracking-tight text-ink">{title}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {items.map((a) => (
        <a href={a.url} class="group block rounded-2xl border border-line p-5 no-underline transition hover:border-ink-3 hover:shadow-sm">
          <span class="text-xs font-semibold uppercase tracking-wide text-brand">{a.kind === "list" ? "Best apps" : a.kind === "guide" ? "Guide" : "Comparison"} · {categoryBySlug[a.category]?.short}</span>
          <span class="mt-1.5 block font-bold leading-6 text-ink group-hover:underline">{a.title}</span>
          <span class="mt-1.5 line-clamp-2 block text-sm leading-6 text-ink-3">{a.description}</span>
        </a>
      ))}
    </div>
  </section>
)}
