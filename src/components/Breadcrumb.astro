---
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-[13px] text-muted">
  <ol class="flex flex-wrap gap-x-2 gap-y-1 list-none m-0 p-0">
    {items.map((it, i) => (
      <li class="flex gap-2 min-w-0">
        {i > 0 && <span aria-hidden="true" class="text-faint">/</span>}
        {it.href ? <a href={it.href} class="text-muted hover:text-primary">{it.name}</a> : <span class="text-ink truncate max-w-[60vw]" aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
