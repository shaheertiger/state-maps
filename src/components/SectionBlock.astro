---
import type { Section } from "../data/types";
import { inline, slugify } from "../lib/md";
interface Props { section: Section; level?: 2 | 3 }
const { section: s, level = 2 } = Astro.props;
const id = slugify(s.heading);
const H = level === 2 ? "h2" : "h3";
---
<H id={id}>{s.heading}</H>
{s.body.map((p) => <p set:html={inline(p)} />)}
{s.steps && (
  <ol class="not-prose my-6 space-y-4">
    {s.steps.map((st, i) => (
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-white">{i + 1}</span>
        <div class="pt-0.5">
          <p class="font-semibold leading-7 text-ink">{st.title}</p>
          <p class="mt-0.5 text-[1rem] leading-7 text-ink-2 [&_a]:text-brand [&_a]:underline" set:html={inline(st.text)} />
        </div>
      </li>
    ))}
  </ol>
)}
{s.bullets && <ul>{s.bullets.map((b) => <li set:html={inline(b)} />)}</ul>}
