---
import { type App, url, level, LEVELS, allTypes } from "../lib/data";
import AppGlyph from "./AppGlyph.astro";
interface Props { app: App }
const { app: a } = Astro.props;
const L = level(a);
const tone = ["pill-caution", "pill-yes", "pill-info", "pill-caution", "pill-no"][L];
---
<a href={url.app(a)} class="app-card lift">
  <div class="flex items-center gap-2.5"><AppGlyph app={a} /><span class="app-card-n">{a.display}</span></div>
  <div class="app-card-f"><span class:list={["pill !text-[12px] !py-0.5 !px-2", tone]}>{LEVELS[L].short}</span>{L >= 2 && <span>{allTypes(a).length} types</span>}</div>
</a>
