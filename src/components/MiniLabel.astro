---
import { type App, level, LEVELS, allTypes } from "../lib/data";
interface Props { app: App }
const { app: a } = Astro.props;
const L = level(a);
const rows = [["Exposure", LEVELS[L].short], ["Tracks you", a.status === "reported" ? (a.track.length ? `Yes · ${a.track.length}` : "No") : "Unknown"], ["Linked to you", String(a.linked.length)], ["Not linked", String(a.notLinked.length)], ["Data types", String(allTypes(a).length)]];
---
<div class="border border-line rounded-[12px] p-4">
  <div class="eyebrow text-muted truncate">{a.display}</div>
  <dl class="grid gap-2 mt-2.5 text-sm m-0">
    {rows.map(([k, v]) => <div class="flex justify-between gap-3"><dt class="text-muted">{k}</dt><dd class="m-0 font-[650] text-right">{v}</dd></div>)}
  </dl>
  <a href={a.sourceUrl} rel="nofollow noopener" class="link text-[13px] mt-3 inline-block">View on the App Store →</a>
</div>
