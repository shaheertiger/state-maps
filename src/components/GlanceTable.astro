---
import AppIcon from "./AppIcon.astro";
import type { App, ListEntry } from "../data/types";
import { getApp } from "../data/index";
import { slugify } from "../lib/md";
interface Props { entries: ListEntry[]; title?: string }
const { entries, title = "At a glance" } = Astro.props;
const rows = entries.map((e, i) => ({ e, a: getApp(e.app) as App, n: i + 1 }));
const anchor = (a: App, n: number) => `${n}-${slugify(a.name)}`;
---
<section aria-labelledby="at-a-glance" class="not-prose my-10">
  <h2 id="at-a-glance" class="mb-4 text-[1.65rem] font-extrabold tracking-tight text-ink">{title}</h2>
  <div class="hidden overflow-hidden rounded-2xl border border-line md:block">
    <table class="tbl">
      <thead>
        <tr><th class="w-10">#</th><th>App</th><th>Best for</th><th>Platforms</th><th>Free plan</th><th>Verdict</th></tr>
      </thead>
      <tbody>
        {rows.map(({ e, a, n }) => (
          <tr>
            <td class="font-bold text-ink-3">{n}</td>
            <td><a href={`#${anchor(a, n)}`} class="flex items-center gap-2 font-semibold text-ink no-underline hover:underline"><AppIcon name={a.name} slug={a.slug} size={26} />{a.name}</a></td>
            <td class="text-ink-2">{a.bestFor}</td>
            <td class="text-ink-2">{a.platforms.join(", ")}</td>
            <td class="text-ink-2">{a.pricing.model === "Built-in" ? "Built in, free" : a.pricing.model === "Free" ? "Free" : a.pricing.model === "Freemium" ? "Yes" : a.pricing.model === "Paid" ? "No (paid)" : "Trial / limited"}</td>
            <td><span class="inline-block rounded-full bg-brand-wash px-2.5 py-0.5 text-xs font-semibold text-brand-2">{e.badge}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ol class="space-y-3 md:hidden">
    {rows.map(({ e, a, n }) => (
      <li class="rounded-xl border border-line p-4">
        <a href={`#${anchor(a, n)}`} class="flex items-center gap-3 no-underline">
          <AppIcon name={a.name} slug={a.slug} size={36} />
          <span><span class="block font-bold text-ink">{n}. {a.name}</span><span class="text-xs font-semibold text-brand">{e.badge}</span></span>
        </a>
        <dl class="mt-3 grid grid-cols-[6.5rem_1fr] gap-y-1 text-sm">
          <dt class="text-ink-3">Best for</dt><dd class="text-ink-2">{a.bestFor}</dd>
          <dt class="text-ink-3">Platforms</dt><dd class="text-ink-2">{a.platforms.join(", ")}</dd>
          <dt class="text-ink-3">Price</dt><dd class="text-ink-2">{a.pricing.model}</dd>
        </dl>
      </li>
    ))}
  </ol>
</section>
