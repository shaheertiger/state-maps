---
/** The privacy label as three tiles: used to track you / linked to you / not linked to you. */
import { type App, level, url, fmtDate } from "../lib/data";
import { CARDS, dataType, bySensitivity } from "../lib/labels";
import Icon from "./fun/Icon.astro";
interface Props { app: App; id?: string }
const { app: a, id = "label" } = Astro.props;
const L = level(a);
const keys = ["track", "linked", "notLinked"] as const;
const ICON = { track: "target", linked: "link", notLinked: "unlink" } as const;
---
<section id={id} class="panel border border-line overflow-hidden" aria-label={`${a.display} App Store privacy label`}>
  <div class="flex flex-wrap items-center justify-between gap-2 px-4 md:px-5 py-3 rowline bg-panel">
    <span class="text-sm font-[700] flex items-center gap-2"><Icon name="shield" size={16} />App Privacy label</span>
    <span class="text-[13px] text-muted">Developer-reported · checked {fmtDate(a.privacyCheckedAt ?? a.retrievedAt)}</span>
  </div>
  {L >= 2 && (
    <div class="grid sm:grid-cols-3 gap-2 md:gap-3 p-2 md:p-3">
      {keys.map((k) => {
        const items = bySensitivity(a[k]);
        return (
          <div class="px-3.5 py-3.5 md:px-4 md:py-4 min-w-0 rounded-[14px]" style={`background:${items.length ? CARDS[k].tint : "#f4f7f6"}`}>
            <div class="lc-h">
              <span class="icon-chip !w-7 !h-7 !rounded-lg bg-white" style={`color:${CARDS[k].ink}`}><Icon name={ICON[k]} size={14} /></span>{CARDS[k].short}
            </div>
            <div class="lc-n" style={`color:${items.length ? CARDS[k].ink : "#9aa8a4"}`}>{items.length}<span class="lc-u">{items.length === 1 ? "type" : "types"}</span></div>
            {items.length ? (
              <ul class="flex flex-wrap gap-1.5 list-none p-0 mt-2.5">{items.map((t) => <li><a href={url.dataType(dataType(t).slug)} class="chip chip-s">{t}</a></li>)}</ul>
            ) : <p class="text-[13px] text-[#4d5b57] mt-2">None declared</p>}
          </div>
        );
      })}
    </div>
  )}
  {L === 1 && (
    <div class="p-3"><div class="rounded-[14px] p-5 flex gap-4 items-center" style="background:var(--color-tint-green)">
      <span class="icon-chip bg-white text-[#17633f]"><Icon name="shieldok" size={20} /></span>
      <div><div class="text-[24px] md:text-[30px] font-[750] tracking-[-0.03em] text-[#17633f] leading-tight">Data Not Collected</div><p class="text-[14px] text-[#34433f] mt-1">The developer states that no data is collected from this app.</p></div>
    </div></div>
  )}
  {L === 0 && (
    <div class="p-3"><div class="rounded-[14px] p-5 flex gap-4 items-center" style="background:var(--color-tint-amber)">
      <span class="icon-chip bg-white text-[#865409]"><Icon name="question" size={20} /></span>
      <div><div class="text-[24px] md:text-[30px] font-[750] tracking-[-0.03em] text-[#865409] leading-tight">No Details Provided</div><p class="text-[14px] text-[#34433f] mt-1">The developer has not provided privacy details on the App Store.</p></div>
    </div></div>
  )}
</section>
