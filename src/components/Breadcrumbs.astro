---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-ink-3">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((it, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < items.length - 1 ? <a href={it.path} class="no-underline hover:text-ink hover:underline">{it.name}</a> : <span aria-current="page" class="text-ink-2">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
