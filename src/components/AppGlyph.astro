---
/** A generated monogram tile (we do not republish App Store artwork). Colour follows the category. */
import type { App } from "../lib/data";
interface Props { app: App; size?: number }
const { app: a, size = 34 } = Astro.props;
const C: Record<string, string> = { productivity: "#2d64ad", utilities: "#4b5a68", finance: "#17633f", "photo-video": "#a1407a", business: "#5a4fb0", lifestyle: "#b26b12", "health-fitness": "#c2412d", medical: "#0f766e", "social-networking": "#2b7bb9" };
const letters = a.display.replace(/[^A-Za-z0-9 ]/g, "").split(" ").filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase() || "A";
---
<span class="glyph" style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.27)}px;background:${C[a.category] ?? "#4b5a68"};font-size:${Math.round(size * 0.38)}px`} aria-hidden="true">{letters}</span>
