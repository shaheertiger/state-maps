---
import { inline } from "../lib/md";
import type { Faq } from "../data/types";
interface Props { items: Faq[]; id?: string; title?: string; level?: 2 | 3 }
const { items, id = "faq", title = "Frequently asked questions" } = Astro.props;
---
<section aria-labelledby={id} class="my-12">
  <h2 id={id} class="mb-5 text-[1.65rem] font-extrabold tracking-tight text-ink">{title}</h2>
  <div class="divide-y divide-line rounded-2xl border border-line">
    {items.map((f, i) => (
      <details class="group px-5 py-4" open={i < 2}>
        <summary class="flex items-start justify-between gap-4">
          <h3 class="text-[1.04rem] font-semibold leading-7 text-ink">{f.q}</h3>
          <svg class="chev mt-1.5 h-5 w-5 shrink-0 text-ink-3 transition" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z" /></svg>
        </summary>
        <p class="mt-2 text-[1rem] leading-7 text-ink-2" set:html={inline(f.a)} />
      </details>
    ))}
  </div>
</section>
