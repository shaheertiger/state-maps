---
import Logo from "./Logo.astro";
import { APPS } from "../lib/data";
const nav = [
  { href: "/app-privacy/", label: "Apps" },
  { href: "/does-it-track-you/", label: "Who tracks you?" },
  { href: "/data-types/", label: "Data types" },
  { href: "/tools/", label: "Tools" },
  { href: "/blog/", label: "Guides" },
];
const here = Astro.url.pathname;
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur rowline">
  <div class="container-site h-[66px] flex items-center gap-2">
    <a href="/" class="flex items-center gap-2.5 font-[760] text-[18px] tracking-[-0.02em] mr-4 hover:text-ink">
      <Logo /><span>State<span class="text-primary">Maps</span></span>
    </a>
    <nav aria-label="Main" class="hidden lg:flex items-center gap-0.5">
      {nav.map((n) => (
        <a href={n.href} class:list={["nav-a", here.startsWith(n.href) && "bg-tab text-ink"]}>{n.label}</a>
      ))}
    </nav>
    <div class="flex-1"></div>
    <form action="/search/" method="get" role="search" class="hidden sm:block">
      <label for="site-q" class="sr-only-x">Search apps</label>
      <input id="site-q" name="q" type="search" placeholder={`Search ${APPS.length.toLocaleString("en-US")} apps…`} autocomplete="off"
        class="text-sm h-10 w-[250px] max-w-full border border-line rounded-full px-4 outline-none bg-panel focus:bg-white focus:border-primary-soft" />
    </form>
    <a href="/search/" aria-label="Search" class="sm:hidden w-11 h-11 border border-line rounded-full grid place-items-center">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    </a>
    <details class="lg:hidden relative">
      <summary aria-label="Menu" class="w-11 h-11 border border-line rounded-full grid place-items-center">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h10M4 17h16"/></svg>
      </summary>
      <nav aria-label="Mobile" class="absolute right-0 top-12 w-64 bg-white border border-line rounded-[14px] p-2 grid shadow-[0_8px_30px_rgba(19,32,29,.1)]">
        {nav.map((n) => <a href={n.href} class="mnav-a">{n.label}</a>)}
        <a href="/privacy-settings/" class="mnav-a">iPhone settings</a>
      </nav>
    </details>
  </div>
</header>
