---
import Logo from "./Logo.astro";
import { categories, listUrl } from "../data/index";
---
<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <Logo />
    <nav aria-label="Main" class="hidden items-center gap-1 text-[0.95rem] md:flex">
      <details class="group relative">
        <summary class="flex items-center gap-1 rounded-md px-3 py-2 font-medium text-ink-2 hover:bg-wash hover:text-ink">
          Best apps
          <svg class="chev h-4 w-4 transition" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z" /></svg>
        </summary>
        <div class="absolute left-0 top-full mt-2 w-80 rounded-xl border border-line bg-white p-2 shadow-lg">
          {categories.map((c) => (
            <a href={listUrl(c.pillar)} class="block rounded-lg px-3 py-2 no-underline hover:bg-wash">
              <span class="block font-semibold text-ink">{c.name}</span>
              <span class="block text-sm text-ink-3">{c.description.split(".")[0]}.</span>
            </a>
          ))}
        </div>
      </details>
      <a href="/guides/" class="rounded-md px-3 py-2 font-medium text-ink-2 no-underline hover:bg-wash hover:text-ink">Guides</a>
      <a href="/reviews/" class="rounded-md px-3 py-2 font-medium text-ink-2 no-underline hover:bg-wash hover:text-ink">Reviews</a>
      <a href="/compare/" class="rounded-md px-3 py-2 font-medium text-ink-2 no-underline hover:bg-wash hover:text-ink">Compare</a>
      <a href="/how-we-review/" class="rounded-md px-3 py-2 font-medium text-ink-2 no-underline hover:bg-wash hover:text-ink">How we review</a>
      <a href="/search/" class="ml-1 rounded-md p-2 text-ink-2 hover:bg-wash hover:text-ink" aria-label="Search">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
      </a>
    </nav>
    <details class="relative md:hidden">
      <summary class="rounded-md border border-line px-3 py-1.5 text-sm font-semibold">Menu</summary>
      <div class="absolute right-0 top-full mt-2 w-72 rounded-xl border border-line bg-white p-2 shadow-lg">
        {categories.map((c) => (
          <a href={listUrl(c.pillar)} class="block rounded-lg px-3 py-2 font-medium text-ink no-underline hover:bg-wash">Best {c.short.toLowerCase()} apps</a>
        ))}
        <hr class="my-2 border-line" />
        <a href="/guides/" class="block rounded-lg px-3 py-2 text-ink no-underline hover:bg-wash">Guides</a>
        <a href="/reviews/" class="block rounded-lg px-3 py-2 text-ink no-underline hover:bg-wash">Reviews</a>
        <a href="/compare/" class="block rounded-lg px-3 py-2 text-ink no-underline hover:bg-wash">Compare</a>
        <a href="/how-we-review/" class="block rounded-lg px-3 py-2 text-ink no-underline hover:bg-wash">How we review</a>
        <a href="/search/" class="block rounded-lg px-3 py-2 text-ink no-underline hover:bg-wash">Search</a>
      </div>
    </details>
  </div>
</header>
