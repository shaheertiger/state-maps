---
import { SITE } from "../lib/site";
---
<a href="/" class="flex items-center gap-2 font-bold text-ink no-underline" aria-label={`${SITE.name} home`}>
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#0f6b5c" />
    <path d="M11 14v-2.5a5 5 0 0 1 10 0V14" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
    <rect x="8.5" y="14" width="15" height="11" rx="2.5" fill="#fff" />
    <circle cx="16" cy="19.5" r="1.8" fill="#0f6b5c" />
  </svg>
  <span class="text-[1.15rem] tracking-tight">{SITE.name}</span>
</a>
