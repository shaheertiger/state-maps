---
import QuestionHub from "../../components/QuestionHub.astro";
import { APPS, hasTrackPage, hasLockPage, LETTERS, letterOf } from "../../lib/data";
export function getStaticPaths() {
  const filter = { track: hasTrackPage, safe: () => true, lock: hasLockPage }["track"];

  const have = new Set(APPS.filter(filter).map((a) => letterOf(a)));
  return LETTERS.filter((L) => have.has(L)).map((letter) => ({ params: { letter } }));
}
---
<QuestionHub kind="track" letter={Astro.params.letter} />
