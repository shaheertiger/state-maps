---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/fun/Icon.astro";
import { DATA_TYPES, CARDS } from "../../lib/labels";
import { APPS, reported, allTypes, url } from "../../lib/data";
import { breadcrumbLd, faqLd, ORG } from "../../lib/schema";
import { abs } from "../../lib/site";
const path = "/data-types/";
const rep = APPS.filter(reported);
const count = (name: string) => rep.filter((a) => allTypes(a).includes(name)).length;
const types = DATA_TYPES.map((d) => ({ ...d, n: count(d.name), t: rep.filter((a) => a.track.includes(d.name)).length })).filter((d) => d.n > 0).sort((a, b) => b.n - a.n);
const crumbs = [{ name: "Home", href: "/" }, { name: "Data types" }];
const faq: [string, string][] = [
  ["What are App Store privacy labels?", "Since December 2020, Apple has required developers to declare what data their app collects and how it is used. The answers appear on each App Store page under App Privacy."],
  ["What are the label sections?", `${CARDS.track.title}: ${CARDS.track.means} ${CARDS.linked.title}: ${CARDS.linked.means} ${CARDS.notLinked.title}: ${CARDS.notLinked.means}`],
  ["Which data type is most common?", `${types[0].name}, on ${Math.round((types[0].n / rep.length) * 100)}% of the ${rep.length.toLocaleString("en-US")} labels in our snapshot, followed by ${types[1].name} and ${types[2].name}.`],
  ["Does 'collected' include data that stays on my iPhone?", "No. Apple counts data as collected when it is sent off the device in a way the developer or its partners can access beyond what is needed to answer a request in real time."],
];
const ld = { "@context": "https://schema.org", "@graph": [ORG, { "@type": "ItemList", name: "App privacy data types", itemListElement: types.map((d, i) => ({ "@type": "ListItem", position: i + 1, name: d.name, url: abs(url.dataType(d.slug)) })) }, breadcrumbLd(crumbs, path), faqLd(faq)] };
---
<Base title="App Privacy Data Types Explained: What Each Label Category Means" description={`All ${types.length} data types on App Store privacy labels, from Identifiers to Health & Fitness, with how many of ${rep.length.toLocaleString("en-US")} iPhone apps collect each one.`} path={path} jsonld={ld}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />
    <div class="kicker kicker-pin mt-5">Label vocabulary · {types.length} types</div>
    <h1 class="h1-page mt-3">Privacy label data types, explained</h1>
    <p class="lead mt-3 max-w-[700px]">Every App Store privacy label is built from the same {types.length} data types. Here is what each one covers, why it matters, and how many apps in our snapshot collect it.</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-10">
      {types.map((d) => (
        <a href={url.dataType(d.slug)} class="lift block p-5 border border-line rounded-[14px] hover:border-[#b9c9c4]">
          <div class="flex items-center gap-3"><span class="icon-chip bg-tint-teal text-teal-ink"><Icon name={d.icon} size={18} /></span><h2 class="!text-[20px]">{d.name}</h2></div>
          <p class="text-[14.5px] text-muted mt-2.5">{d.plain.charAt(0).toUpperCase() + d.plain.slice(1)}.</p>
          <div class="flex gap-3 mt-3 text-[13px] font-[650]"><span>{Math.round((d.n / rep.length) * 100)}% of apps</span>{d.t > 0 && <span class="text-no">{d.t.toLocaleString("en-US")} use it to track</span>}</div>
        </a>
      ))}
    </div>
    <section class="mt-14 max-w-[820px]"><h2 class="h2-page">FAQ</h2><Faq items={faq} /></section>
    <TrustBlock path={path} />
  </div>
</Base>
