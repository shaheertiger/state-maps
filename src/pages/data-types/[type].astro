---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/fun/Icon.astro";
import { DATA_TYPES, CARDS, type DataType } from "../../lib/labels";
import { APPS, CATEGORIES, reported, allTypes, url } from "../../lib/data";
import { breadcrumbLd, faqLd, ORG } from "../../lib/schema";
import { abs, SITE } from "../../lib/site";
export function getStaticPaths() {
  const used = new Set(APPS.flatMap((a) => allTypes(a)));
  return DATA_TYPES.filter((d) => used.has(d.name)).map((d) => ({ params: { type: d.slug }, props: { d } }));
}
const { d } = Astro.props as { d: DataType };
const path = url.dataType(d.slug);
const rep = APPS.filter(reported);
const withIt = rep.filter((a) => allTypes(a).includes(d.name)).sort((a, b) => a.rank - b.rank);
const MAX = 90;
const sections = (["track", "linked", "notLinked"] as const).map((k) => ({ k, apps: withIt.filter((a) => a[k].includes(d.name)) })).filter((s) => s.apps.length);
const byCat = CATEGORIES.map((c) => { const xs = rep.filter((a) => a.category === c.slug); return { c, p: Math.round((xs.filter((a) => allTypes(a).includes(d.name)).length / Math.max(xs.length, 1)) * 100) }; }).sort((a, b) => b.p - a.p);
const pct = Math.round((withIt.length / rep.length) * 100);
const others = DATA_TYPES.filter((x) => x.slug !== d.slug).slice(0, 15);
const h1 = `Apps that collect ${d.name}`;
const faq: [string, string][] = [
  [`What counts as ${d.name} on a privacy label?`, `${d.plain.charAt(0).toUpperCase() + d.plain.slice(1)}. Apple's sub-types are: ${d.includes.join(", ")}.`],
  [`How many iPhone apps collect ${d.name}?`, `${withIt.length.toLocaleString("en-US")} of the ${rep.length.toLocaleString("en-US")} apps with a label in our snapshot (${pct}%). ${sections.find((s) => s.k === "track") ? `${sections.find((s) => s.k === "track")!.apps.length.toLocaleString("en-US")} of them use it to track you.` : "None declare using it for tracking."}`],
  [`How do I limit ${d.name} on iPhone?`, d.setting],
  [`Why does ${d.name} matter?`, d.why],
];
const ld = { "@context": "https://schema.org", "@graph": [ORG, { "@type": "CollectionPage", name: h1, url: abs(path), dateModified: SITE.verifiedISO }, { "@type": "DefinedTerm", name: d.name, description: d.plain, inDefinedTermSet: abs("/data-types/") }, breadcrumbLd([{ name: "Home", href: "/" }, { name: "Data types", href: "/data-types/" }, { name: d.name }], path), faqLd(faq)] };
---
<Base title={`${d.name} on App Privacy Labels: ${withIt.length.toLocaleString("en-US")} iPhone Apps That Collect It`} description={`${pct}% of iPhone apps we checked collect ${d.name.toLowerCase()}. What it covers, which apps use it to track you, and how to limit it in iPhone settings.`} path={path} jsonld={ld}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={[{ name: "Home", href: "/" }, { name: "Data types", href: "/data-types/" }, { name: d.name }]} />
    <div class="mt-5 grid md:grid-cols-[minmax(0,1fr)_300px] gap-10 items-end">
      <div>
        <div class="kicker kicker-pin">Data type · {pct}% of apps</div>
        <h1 class="h1-page mt-3">{h1}</h1>
        <p class="lead mt-3 max-w-[700px]">{d.plain.charAt(0).toUpperCase() + d.plain.slice(1)}. {d.why}</p>
      </div>
      <div class="map-tile hidden md:grid h-[160px] rounded-[18px] place-items-center text-primary"><Icon name={d.icon} size={64} stroke={1.4} /></div>
    </div>
    <div class="grid md:grid-cols-3 gap-3 mt-8">
      <div class="panel p-5 border border-line"><div class="text-[12px] font-bold uppercase tracking-[.08em] text-muted">Includes</div><ul class="flex flex-wrap gap-1.5 list-none p-0 mt-2">{d.includes.map((x) => <li class="chip">{x}</li>)}</ul></div>
      <div class="panel p-5 border border-line md:col-span-2"><div class="text-[12px] font-bold uppercase tracking-[.08em] text-muted">Where to limit it on iPhone</div><p class="mt-1.5 text-[15px]">{d.setting}</p></div>
    </div>
    <dl class="grid grid-cols-3 gap-3 mt-3 m-0">
      {(["track", "linked", "notLinked"] as const).map((k) => { const s = sections.find((x) => x.k === k); return <div class="panel p-4" style={`background:${CARDS[k].tint}`}><dt class="text-[11.5px] font-bold uppercase tracking-[.08em]" style={`color:${CARDS[k].ink}`}>{CARDS[k].short}</dt><dd class="m-0 text-[26px] md:text-[30px] font-[760]" style={`color:${CARDS[k].ink}`}>{(s?.apps.length ?? 0).toLocaleString("en-US")}</dd></div>; })}
    </dl>

    <section class="mt-12">
      <h2 class="h2-page">By category</h2>
      <ul class="list-none p-0 mt-4 grid md:grid-cols-2 gap-x-10 gap-y-2.5">
        {byCat.map(({ c, p }) => <li class="grid grid-cols-[150px_minmax(0,1fr)_44px] items-center gap-3 text-sm"><a href={url.category(c.slug)} class="hover:text-primary">{c.name}</a><span class="h-2.5 rounded-full bg-[#eef3f1]"><span class="block h-full rounded-full bg-primary" style={`width:${p}%`}></span></span><span class="text-right text-muted">{p}%</span></li>)}
      </ul>
    </section>

    {sections.map((s) => (
      <section class="mt-12">
        <h2 class="h2-page">{d.name} — {CARDS[s.k].short.toLowerCase()} <span class="text-muted font-[500]">({s.apps.length.toLocaleString("en-US")})</span></h2>
        <p class="mt-2 text-[15px] text-muted max-w-[760px]">{CARDS[s.k].means}{s.apps.length > MAX && ` Showing the first ${MAX}; browse a category for the rest.`}</p>
        <ul class="list-none p-0 mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6">
          {s.apps.slice(0, MAX).map((a) => <li class="rowline"><a href={url.app(a)} class="flex justify-between gap-3 py-2.5 text-[15px]"><span class="truncate">{a.display}</span><span class="shrink-0 text-[12.5px] text-muted">{CATEGORIES.find((c) => c.slug === a.category)!.name}</span></a></li>)}
        </ul>
      </section>
    ))}

    <section class="mt-12 max-w-[820px]"><h2 class="h2-page">FAQ</h2><Faq items={faq} /></section>
    <p class="mt-10 text-sm">Other data types: {others.map((x, i) => <>{i > 0 && " · "}<a href={url.dataType(x.slug)} class="link">{x.name}</a></>)}</p>
    <TrustBlock path={path} />
  </div>
</Base>
