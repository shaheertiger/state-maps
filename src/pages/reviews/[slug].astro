---
import Base from "../../layouts/Base.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import AppIcon from "../../components/AppIcon.astro";
import FeatureTable from "../../components/FeatureTable.astro";
import Faq from "../../components/Faq.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import Disclosure from "../../components/Disclosure.astro";
import RelatedCards from "../../components/RelatedCards.astro";
import Toc from "../../components/Toc.astro";
import type { App } from "../../data/types";
import { apps, categoryBySlug, categoryUrl, checklistScore, FEATURE_LABELS, listingsFor, listUrl, comparisonsFor, compareUrl, getApp, alternativesFor, altUrl, reviewUrl, relatedArticles, hasAltPage } from "../../data/index";
import { inline, words, readMinutes } from "../../lib/md";
import { SITE } from "../../lib/site";
import { article, breadcrumbs, faqPage, softwareApp } from "../../lib/schema";

export function getStaticPaths() {
  return apps.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: App };
const cat = categoryBySlug[a.categories[0]];
const path = reviewUrl(a.slug);
const updated = "2026-11-08";
const short = a.name.replace(/\s*\(.*\)$/, "");
const title = a.discontinued
  ? `${short} Review: Discontinued, What to Use Now`
  : short.length > 26
    ? `${short} Review (${SITE.year})`
    : a.builtIn
      ? `${short} Review (${SITE.year}): How Private Is It?`
      : `${short} Review (${SITE.year}): Is It Safe?`;
const description = `${a.oneLiner} Our ${a.name} review covers features, pricing, privacy risks and the best alternatives.`.slice(0, 300);
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Reviews", path: "/reviews/" },
  { name: `${a.name} review`, path },
];
const listings = listingsFor(a.slug);
const vs = comparisonsFor(a.slug);
const alts = alternativesFor(a, 3);
const score = checklistScore(a);
const wc = words(a.oneLiner, a.whatItIs, a.howItWorks, a.whoFor, a.strengths, a.tradeoffs, a.privacyNotes, a.faq.map((f) => f.a));
const toc = [
  { id: "verdict", label: "Verdict" },
  { id: "what-it-is", label: `What is ${a.name}?` },
  { id: "how-it-works", label: "How it works" },
  { id: "strengths", label: "Strengths and trade-offs" },
  { id: "checklist", label: "Privacy checklist" },
  { id: "privacy", label: "Is it safe?" },
  { id: "pricing", label: "Pricing" },
  { id: "alternatives", label: "Alternatives" },
  { id: "faq", label: "FAQ" },
];
const schema = [
  { ...article({ title, description, path, published: updated, updated, section: cat.name, keywords: [`${a.name} review`, `is ${a.name} safe`, `${a.name} alternatives`], wordCount: wc }), about: softwareApp(a, path) },
  breadcrumbs(crumbs),
  faqPage(a.faq),
];
const related = relatedArticles([cat.pillar], a.categories[0], "", 2);
---
<Base title={title} description={description} path={path} type="article" published={updated} updated={updated} section={cat.name} schema={schema}>
  <ArticleHeader crumbs={crumbs} kicker={`Review · ${cat.short}`} title={title} published={updated} updated={updated} minutes={readMinutes(wc)} />
  <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <article class="prose-body min-w-0 max-w-3xl pt-8">
      {a.discontinued && (
        <p class="not-prose mb-6 rounded-xl border border-bad/30 bg-[#fdf0ef] p-4 text-[0.97rem] leading-7 text-ink-2"><strong class="text-bad">Discontinued ({a.discontinued}).</strong> {a.name} is no longer available or updated. {hasAltPage(a) ? <a class="link" href={altUrl(a.slug)}>See the best {a.name} alternatives</a> : "See the alternatives below"}.</p>
      )}
      <section id="verdict" class="not-prose rounded-2xl border border-line p-5 sm:p-6">
        <div class="flex items-center gap-4">
          <AppIcon name={a.name} slug={a.slug} size={64} />
          <div>
            <p class="text-xl font-extrabold text-ink">{a.name}</p>
            <p class="text-sm text-ink-3">{a.developer && `${a.developer} · `}{a.platforms.join(", ")}{a.openSource && " · Open source"}</p>
          </div>
          <div class="ml-auto text-right">
            <p class="text-3xl font-extrabold text-ink">{score}<span class="text-base font-semibold text-ink-3">/{FEATURE_LABELS.length}</span></p>
            <a href="/how-we-review/#checklist" class="text-xs font-semibold text-ink-3 no-underline hover:underline">Privacy checklist</a>
          </div>
        </div>
        <p class="mt-5 text-[1.05rem] leading-8 text-ink-2"><strong class="text-ink">Our verdict:</strong> <span set:html={inline(a.oneLiner)} /></p>
        <dl class="mt-4 grid gap-x-6 gap-y-2 text-[0.95rem] sm:grid-cols-2">
          <div><dt class="inline font-semibold text-ink">Best for: </dt><dd class="inline text-ink-2">{a.bestFor}</dd></div>
          <div><dt class="inline font-semibold text-ink">Price: </dt><dd class="inline text-ink-2">{a.pricing.model}</dd></div>
          <div><dt class="inline font-semibold text-ink">Standout: </dt><dd class="inline text-ink-2">{a.standout}</dd></div>
          <div><dt class="inline font-semibold text-ink">Category: </dt><dd class="inline"><a class="link" href={categoryUrl(cat.slug)}>{cat.name}</a></dd></div>
        </dl>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <p class="rounded-xl bg-[#ecf7ef] p-4 text-[0.95rem] leading-7 text-ink-2"><strong class="text-good">Pick it if:</strong> {a.pickIf}</p>
          <p class="rounded-xl bg-[#fdf0ef] p-4 text-[0.95rem] leading-7 text-ink-2"><strong class="text-bad">Skip it if:</strong> {a.skipIf}</p>
        </div>
        {listings.length > 0 && (
          <p class="mt-4 text-sm text-ink-3">
            Ranked {listings.map((x, i) => <>{i > 0 && ", "}<a class="link" href={`${listUrl(x.list.slug)}`}>#{x.rank} in {x.list.title.replace(/\s*\(.*\)$/, "")}</a></>)}
          </p>
        )}
      </section>

      <h2 id="what-it-is">What is {a.name}?</h2>
      <p set:html={inline(a.whatItIs)} />
      <p><strong>Who it's for:</strong> <span set:html={inline(a.whoFor)} /></p>

      <h2 id="how-it-works">How {a.name} works</h2>
      {a.howItWorks.map((p) => <p set:html={inline(p)} />)}

      <h2 id="strengths">{a.name} strengths and trade-offs</h2>
      <div class="not-prose grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-line p-5">
          <p class="font-bold text-good">What's good</p>
          <ul class="mt-2 space-y-2 text-[0.97rem] leading-7 text-ink-2">{a.strengths.map((s) => <li class="flex gap-2"><span class="text-good" aria-hidden="true">+</span>{s}</li>)}</ul>
        </div>
        <div class="rounded-xl border border-line p-5">
          <p class="font-bold text-bad">What's missing</p>
          <ul class="mt-2 space-y-2 text-[0.97rem] leading-7 text-ink-2">{a.tradeoffs.map((s) => <li class="flex gap-2"><span class="text-bad" aria-hidden="true">–</span>{s}</li>)}</ul>
        </div>
      </div>

      <h2 id="checklist">{a.name} privacy checklist</h2>
      <p>The same nine checks we run on every app. {a.name} clearly meets {score} of {FEATURE_LABELS.length}.</p>
      <FeatureTable apps={[a]} />

      <h2 id="privacy">Is {a.name} safe?</h2>
      <p set:html={inline(a.privacyNotes)} />

      <h2 id="pricing">{a.name} pricing</h2>
      <ul>
        <li><strong>Free:</strong> {a.pricing.free}</li>
        <li><strong>Paid:</strong> {a.pricing.paid}</li>
      </ul>
      <p class="text-sm text-ink-3">Prices vary by country and change often. Check the app store listing for the current price before you subscribe.</p>

      {vs.length > 0 && (
        <>
          <h2 id="comparisons">{a.name} compared</h2>
          <ul>
            {vs.map((c) => {
              const o = getApp(c.a === a.slug ? c.b : c.a);
              return <li><a href={compareUrl(c)}>{a.name} vs {o.name}</a>: {c.a === a.slug ? c.chooseA : c.chooseB}</li>;
            })}
          </ul>
        </>
      )}

      <h2 id="alternatives">{a.name} alternatives</h2>
      <div class="not-prose grid gap-3">
        {alts.map((b) => (
          <a href={reviewUrl(b.slug)} class="flex gap-3 rounded-xl border border-line p-4 no-underline hover:border-ink-3">
            <AppIcon name={b.name} slug={b.slug} size={40} />
            <span><span class="block font-semibold text-ink">{b.name}</span><span class="block text-sm leading-6 text-ink-3">{b.oneLiner}</span></span>
          </a>
        ))}
      </div>
      {hasAltPage(a) && <p class="mt-4"><a href={altUrl(a.slug)}>See all {a.name} alternatives →</a></p>}

      <Faq items={a.faq} title={`${a.name} FAQ`} />
      <AuthorBox />
      <Disclosure />
      <RelatedCards items={related} title="Related rankings and guides" />
    </article>
    <aside class="hidden lg:block">
      <div class="sticky top-24 pt-8"><Toc items={toc} /></div>
    </aside>
  </div>
</Base>
