---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AppIcon from "../../components/AppIcon.astro";
import { categories, appsIn, reviewUrl, checklistScore, FEATURE_LABELS } from "../../data/index";
import { breadcrumbs } from "../../lib/schema";
const crumbs = [{ name: "Home", path: "/" }, { name: "Reviews", path: "/reviews/" }];
---
<Base title="All App Reviews: Photo Vaults, App Lockers & Encryption Apps" description="Every privacy, vault, app lock and encryption app we've reviewed, with our privacy checklist score, platforms and who each app is best for." path="/reviews/" schema={[breadcrumbs(crumbs)]}>
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-6 text-[2.2rem] font-extrabold tracking-tight text-ink">App reviews</h1>
    <p class="mt-3 max-w-2xl text-lg leading-8 text-ink-2">Every app we've reviewed, grouped by what it does. The score is how many of our nine privacy checks the app clearly passes.</p>
    {categories.map((c) => (
      <section class="mt-12">
        <h2 class="text-xl font-extrabold tracking-tight text-ink">{c.name}</h2>
        <div class="mt-4 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          {appsIn(c.slug).filter((a) => a.categories[0] === c.slug).map((a) => (
            <a href={reviewUrl(a.slug)} class="flex items-center gap-3 rounded-xl border border-line p-4 no-underline hover:border-ink-3">
              <AppIcon name={a.name} slug={a.slug} size={40} />
              <span class="min-w-0"><span class="block truncate font-semibold text-ink">{a.name} review</span><span class="block text-xs text-ink-3">{a.platforms.join(", ")} · {checklistScore(a)}/{FEATURE_LABELS.length}</span></span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
