---
import Base from "../layouts/Base.astro";
import { getApp, url } from "../lib/data";
const popular = ["google-photos", "whatsapp-messenger", "dropbox", "signal", "paypal", "1password"].map(getApp).filter(Boolean);
---
<Base title="Page Not Found | StateMaps" description="That page does not exist. Search our iPhone app privacy labels or browse by category." path="/404/" noindex>
  <div class="container-site pt-16 max-w-[780px]">
    <div class="kicker kicker-pin">Error 404</div>
    <h1 class="h1-page mt-3">Off the map.</h1>
    <p class="lead mt-3">We could not find that page. Search for an app, or start with one of these.</p>
    <form action="/search/" method="get" class="mt-6 flex gap-2" role="search">
      <label for="q404" class="sr-only">App</label>
      <input id="q404" name="q" type="search" placeholder="Search apps…" class="flex-1 h-12 border border-line rounded-full px-4 text-base outline-none focus:border-primary-soft" />
      <button class="btn-primary">Search</button>
    </form>
    <ul class="list-none p-0 mt-8 grid sm:grid-cols-2 gap-x-6">{popular.map((a) => <li class="rowline"><a href={url.app(a!)} class="block py-3">Is {a!.display} safe?</a></li>)}</ul>
    <p class="mt-6 text-sm"><a class="link" href="/app-privacy/">All apps</a> · <a class="link" href="/blog/">Guides</a> · <a class="link" href="/">Home</a></p>
  </div>
</Base>
