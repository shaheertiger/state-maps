---
import Base from "../layouts/Base.astro";
import { APPS } from "../lib/data";
---
<Base title="Search Apps | StateMaps" description={`Search App Store privacy labels for ${APPS.length.toLocaleString("en-US")} iPhone apps.`} path="/search/" noindex>
  <div class="container-site pt-8 max-w-[780px]">
    <h1 class="h1-page">Search apps</h1>
    <form action="/search/" method="get" class="mt-6 flex gap-2" role="search">
      <label for="q" class="sr-only">App</label>
      <input id="q" name="q" type="search" autocomplete="off" placeholder="e.g. password manager, Dropbox, banking" class="flex-1 h-12 border border-line rounded-full px-4 text-base outline-none focus:border-primary-soft" />
      <button class="btn-primary">Search</button>
    </form>
    <ul class="list-none p-0 mt-6" data-results aria-live="polite"></ul>
    <p class="mt-6 text-sm">Or <a class="link" href="/app-privacy/">browse all apps by category</a>.</p>
  </div>
</Base>
<script>
  import { loadIndex, search, appHref, esc, LEVEL, LEVEL_PILL } from "../scripts/apps";
  const input = document.querySelector<HTMLInputElement>("#q")!;
  const ul = document.querySelector<HTMLElement>("[data-results]")!;
  input.value = new URLSearchParams(location.search).get("q") ?? "";
  const run = async () => {
    const hits = search((await loadIndex()).apps, input.value, 40);
    ul.innerHTML = input.value.trim() && !hits.length ? `<li class="text-muted">No match. Try a simpler word or the developer's name.</li>` :
      hits.map((r) => `<li class="rowline"><a href="${appHref(r)}" class="flex justify-between items-center gap-4 py-3"><span><span class="font-[650]">${esc(r.n)}</span><span class="block text-[13px] text-muted">${esc(r.d)}</span></span><span class="pill ${LEVEL_PILL[r.l]} !text-[12.5px]">${LEVEL[r.l]}</span></a></li>`).join("");
  };
  input.addEventListener("input", run);
  document.querySelector("form")!.addEventListener("submit", (e) => { e.preventDefault(); history.replaceState(null, "", `?q=${encodeURIComponent(input.value)}`); run(); });
  run();
  input.focus();
</script>
