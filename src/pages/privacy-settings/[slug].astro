---
import EditorialPage from "../../components/EditorialPage.astro";
import { privacySettings, type PrivacySetting } from "../../lib/editorial/settings";
import { settingMarkdown } from "../../lib/editorial/markdown";
export function getStaticPaths() { return privacySettings.map((s) => ({ params: { slug: s.slug }, props: { s } })); }
const { s } = Astro.props as { s: PrivacySetting };
const path = `/privacy-settings/${s.slug}/`;
---
<EditorialPage path={path} title={`${s.title}: iPhone Privacy Setting | StateMaps`} h1={s.title} description={s.answer} markdown={settingMarkdown(s)} kicker={`Setting · ${s.group}`}
  crumbs={[{ name: "Home", href: "/" }, { name: "Privacy settings", href: "/privacy-settings/" }, { name: s.title }]} updated={s.updated}
  related={privacySettings.filter((x) => x.slug !== s.slug).slice(0, 5).map((x) => ({ href: `/privacy-settings/${x.slug}/`, label: x.title }))} />
