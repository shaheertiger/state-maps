---
import Page from "../../layouts/Page.astro";
import { SITE } from "../../lib/site";
---
<Page title="Contact Us" description="Contact the StateMaps team with corrections, app suggestions or questions." path="/contact/">
  <p>Email us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  <ul>
    <li><strong>Corrections:</strong> include the page URL and what's wrong. Links to a source help us fix it faster.</li>
    <li><strong>App suggestions:</strong> tell us the app name and why it should be considered.</li>
    <li><strong>Developers:</strong> you're welcome to send factual updates about your app. We don't sell placements or rankings.</li>
  </ul>
</Page>
