---
import Base from "../layouts/Base.astro";
import AppIcon from "../components/AppIcon.astro";
import { categories, listicles, guides, listUrl, guideUrl, categoryUrl, getApp, reviewUrl, comparisons, compareUrl } from "../data/index";
import { SITE } from "../lib/site";
import { organization, website } from "../lib/schema";
import { fmtDate } from "../lib/md";
---
<Base title={`${SITE.name}: Privacy, Vault & App Lock App Reviews (${SITE.year})`} description={SITE.description} path="/" schema={[organization(), website()]}>
  <section class="border-b border-line bg-wash">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Privacy app reviews</p>
      <h1 class="mt-3 max-w-3xl text-[2.3rem] font-extrabold leading-[1.1] tracking-tight text-ink sm:text-[3.2rem]">Find the app that actually keeps your private stuff private.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-ink-2">Photo vaults, app lockers, app hiders and encryption apps, ranked on what they protect, where your files really go, and what happens when something breaks.</p>
      <form action="/search/" method="get" class="mt-8 flex max-w-xl gap-2" role="search">
        <label for="q" class="sr-only">Search apps and guides</label>
        <input id="q" name="q" type="search" placeholder="Try “hide photos iPhone” or “Keepsafe”" class="min-w-0 flex-1 rounded-xl border border-line bg-white px-4 py-3 text-base outline-none focus:border-brand" />
        <button class="btn btn-primary px-5">Search</button>
      </form>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <section class="mt-14" aria-labelledby="top-lists">
      <h2 id="top-lists" class="text-2xl font-extrabold tracking-tight text-ink">Our best-of rankings</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {listicles.map((l) => (
          <a href={listUrl(l.slug)} class="group flex flex-col rounded-2xl border border-line p-5 no-underline transition hover:border-ink-3 hover:shadow-sm">
            <span class="flex gap-1.5">{l.entries.slice(0, 4).map((e) => { const a = getApp(e.app); return <AppIcon name={a.name} slug={a.slug} size={34} class="ring-2 ring-white" />; })}</span>
            <span class="mt-4 block font-bold leading-6 text-ink group-hover:underline">{l.title}</span>
            <span class="mt-2 line-clamp-3 block text-sm leading-6 text-ink-3">{l.description}</span>
            <span class="mt-auto pt-4 text-xs text-ink-3">Updated {fmtDate(l.updated)}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16" aria-labelledby="cats">
      <h2 id="cats" class="text-2xl font-extrabold tracking-tight text-ink">Browse by what you want to protect</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {categories.map((c) => (
          <a href={categoryUrl(c.slug)} class="rounded-2xl bg-wash p-5 no-underline hover:bg-brand-wash">
            <span class="block font-bold text-ink">{c.name}</span>
            <span class="mt-2 block text-sm leading-6 text-ink-3">{c.description}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16 grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-ink">How-to guides</h2>
        <ul class="mt-5 divide-y divide-line border-y border-line">
          {guides.map((g) => <li><a href={guideUrl(g.slug)} class="block py-3.5 font-semibold text-ink no-underline hover:underline">{g.title}</a></li>)}
        </ul>
        <a href="/guides/" class="link mt-4 inline-block text-sm font-semibold">All guides →</a>
      </div>
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-ink">Popular comparisons</h2>
        <ul class="mt-5 divide-y divide-line border-y border-line">
          {comparisons.map((c) => <li><a href={compareUrl(c)} class="block py-3.5 font-semibold text-ink no-underline hover:underline">{getApp(c.a).name} vs {getApp(c.b).name}</a></li>)}
        </ul>
        <a href="/compare/" class="link mt-4 inline-block text-sm font-semibold">All comparisons →</a>
      </div>
    </section>

    <section class="mt-16 rounded-2xl border border-line p-6 sm:p-8">
      <h2 class="text-xl font-extrabold tracking-tight text-ink">How we pick apps</h2>
      <p class="mt-3 max-w-3xl leading-7 text-ink-2">Every app is checked against the same nine-point privacy checklist: real encryption, end-to-end encrypted backups, biometric unlock, decoy PIN, intruder alerts, a hidden icon, backups, no-account setup and no ads. We check each claim against the developer's own documentation, and no app can pay for a better spot.</p>
      <a href="/how-we-review/" class="btn btn-ghost mt-5">Read our methodology</a>
    </section>
  </div>
</Base>
