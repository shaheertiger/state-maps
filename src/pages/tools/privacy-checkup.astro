---
import Tool from "../../layouts/Tool.astro";
import { reviewQuestions, reviewActions } from "../../lib/editorial/privacy-review";
import { toolGuidance } from "../../lib/editorial/tool-guidance";
const guidance = toolGuidance["privacy-checkup"] ?? [];
const faq: [string, string][] = [
  ["Does the checkup read my iPhone settings?", "No. It builds guidance from the three answers you choose. It never inspects your device, photo library or Apple Account."],
  ["Is my review saved?", "Only if you tap Save on this device, which keeps your choices in this browser's local storage. Clear removes it."],
  ["Can I print it?", "Yes. Use Print to save it as a PDF, or Download for a plain-text copy."],
  ...guidance.slice(0, 3).map((g) => [g.heading, g.body] as [string, string]),
];
---
<Tool slug="privacy-checkup" title="iPhone Privacy Checkup: Build Your Photo & App Privacy Review" h1="iPhone privacy checkup"
  description="Answer three questions about your photos, cloud storage and who else has access, and get a prioritised iPhone privacy review you can save, print or download."
  lead="Choose your goal, storage setup and access concern. You get a prioritised review with a guide for each step. Nothing leaves your browser." faq={faq}>
  <Fragment slot="form">
    <form class="grid gap-5" data-review>
      {reviewQuestions.map((q) => (
        <fieldset class="m-0 p-0 border-0"><legend class="text-[15px] font-[700]">{q.label}</legend>
          <div class="flex flex-wrap gap-2 mt-2.5">{q.options.map(([v, l], i) => <label class="!inline-flex items-center gap-2 !mb-0 border border-line rounded-[10px] px-3 py-2 cursor-pointer font-[550] has-[:checked]:border-primary has-[:checked]:bg-tint-teal"><input type="radio" name={q.id} value={v} checked={i === 0} class="accent-[#0f766e]" />{l}</label>)}</div>
        </fieldset>
      ))}
    </form>
  </Fragment>
  <div slot="empty" data-result></div>
  {guidance.map((g) => <><h2>{g.heading}</h2><p>{g.body}</p></>)}
  <h2>All possible steps</h2>
  <ul>{reviewActions.map((a) => <li><a href={`/blog/${a.slug}/`}>{a.title}</a>: {a.body}</li>)}</ul>
</Tool>
<script>
  import { buildReview, reviewQuestions } from "../../lib/editorial/privacy-review";
  const form = document.querySelector<HTMLFormElement>("[data-review]")!;
  const out = document.querySelector<HTMLElement>("[data-result]")!;
  const KEY = "sm-review";
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const answers = () => Object.fromEntries(reviewQuestions.map((q) => [q.id, (form.elements.namedItem(q.id) as RadioNodeList).value]));
  const apply = (a: Record<string, string>) => { for (const [k, v] of Object.entries(a)) { const el = form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${CSS.escape(v)}"]`); if (el) el.checked = true; } };
  const params = new URLSearchParams(location.search);
  if (params.size) apply(Object.fromEntries(params)); else { try { const s = localStorage.getItem(KEY); if (s) apply(JSON.parse(s)); } catch {} }
  const text = (steps: ReturnType<typeof buildReview>) => steps.map((s, i) => `${i + 1}. ${s.title}\n   ${s.body}\n   ${location.origin}/blog/${s.slug}/`).join("\n\n");
  const render = () => {
    const a = answers();
    const steps = buildReview(a);
    out.innerHTML = `<div class="font-[700] text-[17px]">Your review: ${steps.length} steps</div><ol class="grid gap-2.5 list-none p-0 mt-3">${steps.map((s, i) => `<li class="flex gap-3 bg-white border border-line rounded-[12px] p-3.5"><span class="w-7 h-7 rounded-full bg-primary text-white grid place-items-center text-[13px] font-[750] shrink-0">${i + 1}</span><div><div class="font-[650]">${esc(s.title)}</div><p class="text-[14px] text-muted mt-0.5">${esc(s.body)} <a class="link" href="/blog/${s.slug}/">Guide →</a></p></div></li>`).join("")}</ol>
      <div class="flex flex-wrap gap-2 mt-4 text-sm"><button type="button" data-a="save" class="btn-primary !py-2">Save on this device</button><button type="button" data-a="clear" class="px-4 py-2 rounded-full border border-line font-[600]">Clear saved</button><button type="button" data-a="print" class="px-4 py-2 rounded-full border border-line font-[600]">Print / PDF</button><button type="button" data-a="dl" class="px-4 py-2 rounded-full border border-line font-[600]">Download text</button><button type="button" data-a="link" class="px-4 py-2 rounded-full border border-line font-[600]">Copy link</button></div><p class="text-[12px] text-muted mt-2" data-msg></p>`;
    out.querySelectorAll<HTMLButtonElement>("[data-a]").forEach((b) => b.onclick = async () => {
      const msg = out.querySelector("[data-msg]")!;
      if (b.dataset.a === "save") { try { localStorage.setItem(KEY, JSON.stringify(a)); msg.textContent = "Saved in this browser only."; } catch { msg.textContent = "This browser blocked local storage."; } }
      if (b.dataset.a === "clear") { try { localStorage.removeItem(KEY); } catch {} msg.textContent = "Saved review cleared."; }
      if (b.dataset.a === "print") window.print();
      if (b.dataset.a === "dl") { const url = URL.createObjectURL(new Blob([`iPhone privacy review\n\n${text(steps)}\n`], { type: "text/plain" })); const l = document.createElement("a"); l.href = url; l.download = "iphone-privacy-review.txt"; l.click(); URL.revokeObjectURL(url); }
      if (b.dataset.a === "link") { const u = `${location.origin}${location.pathname}?${new URLSearchParams(a)}`; try { await navigator.clipboard.writeText(u); msg.textContent = "Link copied. It contains only your three general choices."; } catch { msg.textContent = u; } }
    });
  };
  form.addEventListener("change", render);
  render();
</script>
