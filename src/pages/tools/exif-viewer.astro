---
import Tool from "../../layouts/Tool.astro";
import { toolGuidance } from "../../lib/editorial/tool-guidance";
const guidance = toolGuidance["exif-viewer"] ?? [];
const faq: [string, string][] = [
  ["Is my photo uploaded?", "No. The file is read by your browser on your device. Nothing is sent to a server."],
  ["Which formats work?", "JPEG files with EXIF metadata, up to 20 MB. HEIC, PNG and WebP metadata are not analysed; export a JPEG copy to inspect it."],
  ["Does the clean copy remove everything?", "The PNG copy is re-drawn from pixels, so EXIF fields are not carried over. Anything visible in the picture itself — a street sign, a face — stays."],
  ...guidance.slice(0, 2).map((g) => [g.heading, g.body] as [string, string]),
];
---
<Tool slug="exif-viewer" title="Photo Metadata Viewer: See Location & EXIF Data in a JPEG (No Upload)" h1="Photo metadata viewer"
  description="Check whether a photo contains GPS location, camera and date details before you share it. Runs in your browser; the photo is never uploaded."
  lead="Choose a JPEG. We read its EXIF metadata — location, date, camera — right here in your browser, and can make a clean copy without it." faq={faq}>
  <Fragment slot="form"><div><label for="file">Photo (JPEG, up to 20 MB)</label><input id="file" type="file" accept="image/jpeg,.jpg,.jpeg" class="block w-full text-sm file:mr-3 file:rounded-full file:border-0 file:bg-primary file:text-white file:px-4 file:py-2 file:font-[650]" /></div></Fragment>
  <p slot="empty" class="text-muted text-[19px]">Metadata appears here. Your file stays on this device.</p>
  {guidance.map((g) => <><h2>{g.heading}</h2><p>{g.body}</p></>)}
  <h2>Stop new photos recording location</h2>
  <p>Settings › Privacy & Security › Location Services › Camera › Never. When sharing from Photos, tap Options at the top of the share sheet and switch off Location. Read more in <a href="/blog/remove-photo-location-iphone/">how to remove photo location on iPhone</a>.</p>
</Tool>
<script>
  import { readPhotoMetadata } from "../../lib/editorial/photo-metadata";
  const input = document.querySelector<HTMLInputElement>("#file")!;
  const out = document.querySelector<HTMLElement>("[data-out]")!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  input.addEventListener("change", async () => {
    const f = input.files?.[0];
    if (!f) return;
    if (f.size > 20 * 1048576) { out.innerHTML = `<p class="text-no">That file is over 20 MB.</p>`; return; }
    const r = readPhotoMetadata(await f.arrayBuffer());
    const rows = Object.entries(r.fields);
    const gps = rows.some(([k]) => /gps|latitude|longitude|location/i.test(k));
    out.innerHTML = `<div class="flex flex-wrap gap-2 items-center"><span class="pill ${gps ? "pill-no" : "pill-yes"}">${gps ? "Location found" : "No location field read"}</span><span class="text-sm text-muted">${esc(r.format)} · ${r.exif ? "EXIF present" : "no EXIF block read"}</span></div>
      ${rows.length ? `<div class="table-wrap bg-white mt-4"><table class="data-table"><tbody>${rows.map(([k, v]) => `<tr><td class="text-muted">${esc(k)}</td><td>${esc(String(v))}</td></tr>`).join("")}</tbody></table></div>` : ""}
      ${r.warnings.map((w) => `<p class="text-[13px] text-caution mt-2">${esc(w)}</p>`).join("")}
      <button type="button" class="btn-primary mt-4" data-clean>Download clean PNG copy</button>`;
    out.querySelector<HTMLButtonElement>("[data-clean]")!.onclick = async () => {
      const bmp = await createImageBitmap(f);
      const c = document.createElement("canvas"); c.width = bmp.width; c.height = bmp.height; c.getContext("2d")!.drawImage(bmp, 0, 0);
      c.toBlob((b) => { if (!b) return; const u = URL.createObjectURL(b); const a = document.createElement("a"); a.href = u; a.download = f.name.replace(/\.[^.]+$/, "") + "-clean.png"; a.click(); URL.revokeObjectURL(u); }, "image/png");
    };
  });
</script>
