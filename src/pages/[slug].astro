---
// "Best X apps" listicles live at the root (/best-photo-vault-apps/), like the top-ranking pages.
import Base from "../layouts/Base.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import Takeaways from "../components/Takeaways.astro";
import Toc from "../components/Toc.astro";
import GlanceTable from "../components/GlanceTable.astro";
import AppEntry from "../components/AppEntry.astro";
import SectionBlock from "../components/SectionBlock.astro";
import FeatureTable from "../components/FeatureTable.astro";
import TrustBlock from "../components/TrustBlock.astro";
import Faq from "../components/Faq.astro";
import AuthorBox from "../components/AuthorBox.astro";
import Disclosure from "../components/Disclosure.astro";
import RelatedCards from "../components/RelatedCards.astro";
import type { Listicle } from "../data/types";
import { listicles, getApp, categoryBySlug, categoryUrl, relatedArticles, reviewUrl, listUrl } from "../data/index";
import { inline, slugify, words, readMinutes } from "../lib/md";
import { article, breadcrumbs, faqPage, itemList, organization, website } from "../lib/schema";

export function getStaticPaths() {
  return listicles.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props as { l: Listicle };
const cat = categoryBySlug[l.category];
const path = listUrl(l.slug);
const apps = l.entries.map((e) => getApp(e.app));
const crumbs = [
  { name: "Home", path: "/" },
  { name: cat.name, path: categoryUrl(cat.slug) },
  { name: l.title.replace(/\s*\(.*\)$/, ""), path },
];
const wc = words(
  l.intro, l.takeaways, l.entries.map((e) => e.why),
  apps.map((a) => [a.whatItIs, a.howItWorks, a.whoFor, a.pickIf, a.skipIf, a.strengths, a.tradeoffs, a.privacyNotes, a.pricing.free, a.pricing.paid]).flat(2),
  l.afterList.map((s) => [s.body, (s.steps ?? []).map((x) => x.text), s.bullets ?? []]).flat(2),
  l.faq.map((f) => f.a),
);
const toc = [
  { id: "at-a-glance", label: "At a glance" },
  ...l.entries.map((e, i) => ({ id: `${i + 1}-${slugify(getApp(e.app).name)}`, label: `${i + 1}. ${getApp(e.app).name}`, sub: true })),
  { id: "privacy-checklist-compared", label: "Privacy checklist compared" },
  ...l.afterList.map((s) => ({ id: slugify(s.heading), label: s.heading })),
  { id: "why-trust-us", label: "Why trust this list" },
  { id: "faq", label: "FAQ" },
];
const schema = [
  article({ type: "BlogPosting", title: l.title, description: l.description, path, published: l.published, updated: l.updated, section: cat.name, keywords: [l.keyword, ...l.keywords], wordCount: wc }),
  breadcrumbs(crumbs),
  itemList(l.title, apps.map((a) => ({ app: a, path: reviewUrl(a.slug) }))),
  faqPage(l.faq),
  organization(),
  website(),
];
const related = relatedArticles(l.related, l.category, l.slug, 4);
const compared = apps.slice(0, 5);
---
<Base title={l.seoTitle ?? l.title} description={l.description} path={path} type="article" published={l.published} updated={l.updated} section={cat.name} tags={[l.keyword, ...l.keywords]} schema={schema}>
  <ArticleHeader crumbs={crumbs} kicker={`Best apps · ${cat.short}`} title={l.title} published={l.published} updated={l.updated} minutes={readMinutes(wc)} />
  <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <article class="prose-body min-w-0 max-w-3xl pt-8">
      {l.intro.map((p) => <p set:html={inline(p)} />)}
      <Takeaways items={l.takeaways} />
      <GlanceTable entries={l.entries} />
      {l.entries.map((e, i) => <AppEntry entry={e} n={i + 1} others={l.entries.map((x) => x.app).filter((s) => s !== e.app)} />)}

      <h2 id="privacy-checklist-compared">Privacy checklist compared</h2>
      <p>How the top {compared.length} picks stack up on the nine things that decide whether a privacy app actually protects you. "Not confirmed" means the developer doesn't document it clearly, so don't count on it.</p>
      <FeatureTable apps={compared} />

      {l.afterList.map((s) => <SectionBlock section={s} />)}

      <TrustBlock />
      <Faq items={l.faq} />
      <AuthorBox />
      <Disclosure />
      <RelatedCards items={related} title="Keep reading" />
    </article>
    <aside class="hidden lg:block">
      <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-8 pt-8">
        <Toc items={toc} />
        <a href={categoryUrl(cat.slug)} class="mt-6 block rounded-xl border border-line p-4 text-sm no-underline hover:border-ink-3">
          <span class="block font-semibold text-ink">All {cat.short.toLowerCase()} apps</span>
          <span class="mt-1 block text-ink-3">Reviews, comparisons and guides</span>
        </a>
      </div>
    </aside>
  </div>
</Base>
