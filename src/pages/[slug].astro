---
/**
 * Every root-level app URL:
 *   /is-{app}-safe/   /does-{app}-track-you/   /how-to-lock-{app}-on-iphone/
 * Variant pages exist only where they have something to say (see variantsOf).
 * SM_LIMIT=50 builds a small sample for quick local checks.
 */
import AppPage from "../components/AppPage.astro";
import VariantPage from "../components/VariantPage.astro";
import { APPS, variantsOf, variantPath, type App, type Variant } from "../lib/data";

export function getStaticPaths() {
  const limit = Number(import.meta.env.SM_LIMIT ?? process.env.SM_LIMIT ?? 0);
  const apps = limit ? APPS.slice(0, limit) : APPS;
  return apps.flatMap((app: App) =>
    variantsOf(app).map((variant: Variant) => ({
      params: { slug: variantPath(app, variant).replace(/^\/|\/$/g, "") },
      props: { app, variant },
    })),
  );
}
const { app, variant } = Astro.props as { app: App; variant: Variant };
---
{variant === "app" ? <AppPage app={app} /> : <VariantPage app={app} variant={variant} />}
