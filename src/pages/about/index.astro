---
import EditorialPage from "../../components/EditorialPage.astro";
import { staticMarkdown } from "../../lib/editorial/markdown";
import { infoPages } from "../../lib/editorial/pages";
import { reviewedDate } from "../../lib/editorial/content";
const p = infoPages["/about"];
---
<EditorialPage path="/about/" title={`${p.title} | StateMaps`} h1={p.title} description={p.description} markdown={staticMarkdown["/about"]()} kicker="StateMaps" crumbs={[{ name: "Home", href: "/" }, { name: p.title }]} updated={reviewedDate} article={false} partner={false} />
