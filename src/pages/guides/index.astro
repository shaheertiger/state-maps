---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { categories, guides, guideUrl } from "../../data/index";
import { breadcrumbs } from "../../lib/schema";
const crumbs = [{ name: "Home", path: "/" }, { name: "Guides", path: "/guides/" }];
---
<Base title="Privacy How-To Guides: Hide Apps, Lock Apps, Hide Photos" description="Step-by-step guides to hiding apps, locking apps, hiding photos and encrypting files on iPhone, Android and your computer." path="/guides/" schema={[breadcrumbs(crumbs)]}>
  <div class="mx-auto max-w-4xl px-4 pt-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-6 text-[2.2rem] font-extrabold tracking-tight text-ink">How-to guides</h1>
    <p class="mt-3 text-lg leading-8 text-ink-2">Step-by-step instructions for the built-in privacy features on your phone, plus when a third-party app is worth it.</p>
    {categories.map((c) => {
      const gs = guides.filter((g) => g.category === c.slug);
      return gs.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-extrabold tracking-tight text-ink">{c.name}</h2>
          <ul class="mt-4 space-y-3">
            {gs.map((g) => (
              <li><a href={guideUrl(g.slug)} class="block rounded-xl border border-line p-4 no-underline hover:border-ink-3"><span class="block font-semibold text-ink">{g.title}</span><span class="mt-1 block text-sm leading-6 text-ink-3">{g.description}</span></a></li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</Base>
