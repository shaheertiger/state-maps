# Set the production HTTPS origin before deploying (no path or trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional Google Search Console ownership token, issued for your domain.
GOOGLE_SITE_VERIFICATION=
# Optional Google Tag Manager container. Tags load only after visitor opt-in.
# Configure your own analytics/conversion services inside that container.
NEXT_PUBLIC_GTM_ID=
